@import "tailwindcss";

:root {
  --bg: #09090b;
  --panel: #111113;
  --panel-hover: #18181b;
  --border: rgba(255,255,255,.08);
  --text: #f5f5f5;
  --muted: #8b8b93;
  --accent: #ffffff;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

body {
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 230px;
  padding: 26px 18px;
  background: #0d0d0f;
  border-right: 1px solid var(--border);
  z-index: 1000;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 10px 28px;
}

.logo-mark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #fff;
  color: #09090b;
  font-size: 15px;
  font-weight: 800;
}

.logo strong,
.logo {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -.02em;
}

.menu-title {
  padding: 0 10px;
  margin: 14px 0 9px;
  color: #66666e;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 10px 11px;
  margin: 3px 0;
  border-radius: 9px;
  color: #8d8d95;
  text-decoration: none;
  font-size: 13px;
  transition: .18s ease;
}

.nav-item:hover {
  background: #171719;
  color: #fff;
}

.nav-item.active {
  background: #1d1d20;
  color: #fff;
}

.nav-icon {
  width: 18px;
  text-align: center;
  font-size: 15px;
}

.sidebar-divider {
  height: 1px;
  margin: 20px 10px;
  background: var(--border);
}

.sidebar-bottom {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 20px;
}

/* =========================
   MAIN CONTENT
========================= */

.content {
  margin-left: 230px;
  min-height: 100vh;
  padding: 30px 42px 150px;
  max-width: 1500px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30px;
}

.eyebrow,
.section-label,
.hero-label,
.lyrics-label,
.queue-label {
  color: #77777f;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .13em;
}

.topbar h1 {
  margin: 4px 0 0;
  font-size: 22px;
  letter-spacing: -.04em;
}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  min-height: 310px;
  padding: 42px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: #111113;
}

.hero-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  right: -100px;
  top: -150px;
  border-radius: 50%;
  background: rgba(255,255,255,.035);
  filter: blur(40px);
  pointer-events: none;
}

.hero-text {
  position: relative;
  z-index: 2;
  max-width: 600px;
}

.hero h1 {
  margin: 12px 0;
  font-size: clamp(42px, 6vw, 72px);
  line-height: .95;
  letter-spacing: -.065em;
}

.hero .subtitle {
  max-width: 470px;
  margin: 0 0 25px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}

.hero-search,
.search {
  display: flex;
  align-items: center;
}

.hero-search {
  width: min(470px, 100%);
  padding: 5px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #0b0b0d;
}

.hero-search input,
.search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #fff;
  padding: 12px;
  font-size: 13px;
}

.hero-search button,
.search button {
  border: 0;
  border-radius: 9px;
  padding: 10px 15px;
  background: #fff;
  color: #09090b;
  font-weight: 700;
}

.hero-art {
  position: absolute;
  right: 7%;
  width: 210px;
  height: 210px;
  display: grid;
  place-items: center;
}

.disc {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle,
      #19191d 0,
      #19191d 5px,
      #0b0b0d 6px,
      #0b0b0d 9px
    );
  box-shadow: 0 25px 70px rgba(0,0,0,.55);
}

.disc-center {
  position: absolute;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  border: 12px solid #222228;
}

.cover-play,
.card-play {
  border: 0;
  background: #fff;
  color: #08080a;
}

/* =========================
   SECTIONS
========================= */

.section {
  margin-top: 48px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin: 5px 0 0;
  font-size: 22px;
  letter-spacing: -.04em;
}

.section-heading > span {
  color: #77777f;
  font-size: 12px;
}

/* =========================
   MUSIC CARDS
========================= */

.music-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.music-card {
  min-width: 0;
}

.card-image {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 14px;
  background: #151518;
}

.card-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .25s ease;
}

.music-card:hover .card-image img {
  transform: scale(1.035);
}

.card-play {
  position: absolute;
  right: 12px;
  bottom: 12px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  opacity: 0;
  transform: translateY(5px);
  transition: .2s ease;
}

.music-card:hover .card-play {
  opacity: 1;
  transform: translateY(0);
}

.music-card strong {
  display: block;
  margin-top: 11px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 13px;
}

.music-card > span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================
   SEARCH RESULTS
========================= */

.song-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.song-row {
  position: relative;
  display: grid !important;
  grid-template-columns: 38px 52px minmax(0,1fr) auto auto !important;
  align-items: center;
  gap: 13px;
  min-height: 62px;
  padding: 7px 12px;
  border-radius: 10px;
  transition: background .15s ease;
}

.song-row:hover {
  background: #151517;
}

.song-number {
  color: #55555d;
  font-size: 11px;
  text-align: center;
}

.song-cover {
  width: 52px;
  height: 52px;
  overflow: hidden;
  border-radius: 8px;
  background: #18181b;
}

.song-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.song-info {
  min-width: 0;
}

.song-info strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}

.song-info span,
.song-album,
.song-duration {
  color: var(--muted);
  font-size: 11px;
}

.song-info span {
  display: block;
  margin-top: 5px;
}

.song-row button {
  border: 0;
  background: transparent;
  color: #77777f;
}

.song-row button:hover {
  color: #fff;
}

/* =========================
   MOODS
========================= */

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.mood-card {
  min-height: 115px;
  display: flex;
  align-items: flex-end;
  gap: 12px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: #111113;
  transition: .2s ease;
}

.mood-card:hover {
  background: #18181b;
  transform: translateY(-2px);
}

.mood-card > span {
  font-size: 23px;
}

.mood-card b {
  display: block;
  font-size: 13px;
}

.mood-card small {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

/* =========================
   PLAYER
========================= */

.player {
  position: fixed !important;
  left: 250px !important;
  right: 20px !important;
  bottom: 18px !important;
  z-index: 5000;

  min-height: 78px;
  padding: 10px 16px;
  display: grid !important;
  grid-template-columns: minmax(190px,1fr) minmax(300px,1.5fr) minmax(180px,1fr);
  align-items: center;
  gap: 20px;

  background: rgba(17,17,19,.96);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  box-shadow: 0 18px 50px rgba(0,0,0,.45);
  backdrop-filter: blur(18px);
}

.player-song {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}

.player-cover {
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  overflow: hidden;
  border-radius: 9px;
}

.player-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.player-cover.playing img {
  animation: none !important;
}

.player-song-info {
  min-width: 0;
}

.player-song-info strong {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 12px;
}

.player-song-info span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

.player-center {
  min-width: 0;
}

.player-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.player-buttons button {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #9999a1;
  transition: .15s ease;
}

.player-buttons button:hover {
  color: #fff;
  background: #202023;
}

.player-buttons .play-button {
  width: 42px;
  height: 42px;
  background: #fff;
  color: #09090b;
  font-size: 14px;
}

.progress {
  display: grid !important;
  grid-template-columns: 32px 1fr 32px;
  align-items: center;
  gap: 8px;
  margin-top: 5px;
}

.progress > span {
  color: #707078;
  font-size: 9px;
  text-align: center;
}

.progress-bar {
  position: relative;
  height: 4px;
  border-radius: 99px;
  background: #303034;
}

.progress-fill {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: 99px;
  background: #fff;
  pointer-events: none;
}

.progress-bar input {
  position: absolute;
  inset: -6px 0;
  width: 100%;
  height: 16px;
  opacity: 0;
  cursor: pointer;
}

.player-actions {
  display: flex;
  justify-content: flex-end;
  gap: 7px;
}

.lyrics-button {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px;
  background: transparent;
  color: #888890;
  font-size: 11px;
}

.lyrics-button:hover,
.lyrics-button.active {
  background: #1d1d20;
  color: #fff;
}

.player-volume {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.player-volume span {
  font-size: 12px;
}

.player-volume input {
  width: 85px;
}

/* =========================
   QUEUE
========================= */

.queue-panel,
.lyrics-panel {
  position: fixed;
  z-index: 10001;
  background: #111113;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  box-shadow: 0 25px 70px rgba(0,0,0,.55);
  overflow: hidden;
}

.queue-panel {
  right: 40px;
  bottom: 110px;
  width: 380px;
  max-height: 520px;
}

.queue-header,
.lyrics-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px;
  border-bottom: 1px solid var(--border);
}

.queue-header h3,
.lyrics-header h3 {
  margin: 5px 0 0;
  font-size: 16px;
}

.queue-close {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #888;
  font-size: 20px;
}

.queue-close:hover {
  background: #1c1c20;
  color: #fff;
}

.queue-list {
  max-height: 420px;
  overflow-y: auto;
  padding: 8px;
}

.queue-item {
  display: grid;
  grid-template-columns: 20px 20px 42px minmax(0,1fr) auto 25px;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border-radius: 9px;
}

.queue-item:hover {
  background: #19191c;
}

.queue-drag,
.queue-number {
  color: #66666e;
  font-size: 10px;
}

.queue-cover {
  width: 42px;
  height: 42px;
  overflow: hidden;
  border-radius: 7px;
}

.queue-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.queue-info {
  min-width: 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.queue-info strong,
.queue-info span {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.queue-info strong {
  color: #eee;
  font-size: 11px;
}

.queue-info span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.queue-duration {
  color: #66666e;
  font-size: 9px;
}

.queue-remove {
  border: 0;
  background: transparent;
  color: #666;
  font-size: 17px;
}

.queue-empty {
  padding: 55px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.queue-empty-icon {
  margin-bottom: 12px;
  font-size: 30px;
  color: #555;
}

.queue-empty strong {
  font-size: 13px;
}

.queue-empty span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================
   LYRICS
========================= */

.lyrics-panel {
  width: 380px;
  max-width: 90vw;
  max-height: 80vh;
}

.lyrics-body {
  height: 380px;
  overflow-y: auto;
  padding: 20px;
  text-align: center;
}

.lyrics-line {
  margin: 14px 0;
  color: #77777f;
  font-size: 15px;
  line-height: 1.5;
  transition: .15s ease;
}

.lyrics-active {
  color: #fff !important;
  font-size: 20px !important;
  font-weight: 700;
}

.lyrics-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  color: #666;
  font-size: 10px;
}

.lyrics-like {
  border: 0;
  border-radius: 7px;
  padding: 7px 10px;
  background: #1c1c20;
  color: #aaa;
}

.lyrics-like.liked {
  color: #fff;
}

/* Resize handles */

.panel-resize-handle {
  position: absolute;
  z-index: 20;
}

.resize-n,
.resize-s {
  left: 10px;
  right: 10px;
  height: 8px;
}

.resize-n { top: -4px; }
.resize-s { bottom: -4px; }

.resize-e,
.resize-w {
  top: 10px;
  bottom: 10px;
  width: 8px;
}

.resize-e { right: -4px; }
.resize-w { left: -4px; }

.resize-ne,
.resize-nw,
.resize-se,
.resize-sw {
  width: 14px;
  height: 14px;
}

.resize-ne { right: -5px; top: -5px; }
.resize-nw { left: -5px; top: -5px; }
.resize-se { right: -5px; bottom: -5px; }
.resize-sw { left: -5px; bottom: -5px; }

/* =========================
   MOBILE
========================= */

@media (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }

  .content {
    margin-left: 190px;
    padding: 24px;
  }

  .hero-art {
    opacity: .4;
    right: 0;
  }

  .music-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .mood-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .player {
    left: 205px !important;
    grid-template-columns: 1fr 1.2fr;
  }

  .player-actions,
  .player-volume {
    display: none;
  }
}

@media (max-width: 650px) {
  .sidebar {
    display: none;
  }

  .content {
    margin-left: 0;
    padding: 18px 15px 130px;
  }

  .hero {
    min-height: 300px;
    padding: 28px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .hero-art {
    display: none;
  }

  .music-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .mood-grid {
    grid-template-columns: 1fr 1fr;
  }

  .song-row {
    grid-template-columns: 28px 45px minmax(0,1fr) auto !important;
  }

  .song-cover {
    width: 45px;
    height: 45px;
  }

  .song-album {
    display: none;
  }

  .player {
    left: 10px !important;
    right: 10px !important;
    bottom: 10px !important;
    grid-template-columns: 1fr;
    padding: 9px;
  }

  .player-center {
    grid-row: 2;
  }

  .player-buttons {
    margin-top: 2px;
  }

  .queue-panel {
    left: 10px;
    right: 10px;
    bottom: 100px;
    width: auto;
  }

  .lyrics-panel {
    left: 10px !important;
    right: 10px !important;
    width: auto !important;
  }
}

/* =========================================
   AURALIS — WATER GLASS UI
========================================= */

:root {
  --glass-bg: rgba(255, 255, 255, 0.055);
  --glass-bg-hover: rgba(255, 255, 255, 0.085);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-highlight: rgba(255, 255, 255, 0.18);
}

/* Main background */
html,
body {
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(120, 150, 255, 0.07),
      transparent 32%
    ),
    radial-gradient(
      circle at 85% 30%,
      rgba(180, 120, 255, 0.055),
      transparent 30%
    ),
    #08090c !important;
}

/* Glass sidebar */
.sidebar {
  background: rgba(18, 19, 23, 0.68) !important;
  border-right: 1px solid var(--glass-border) !important;

  backdrop-filter: blur(28px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(140%) !important;

  box-shadow:
    inset -1px 0 rgba(255,255,255,.035),
    0 0 40px rgba(0,0,0,.18) !important;
}

/* Glass navigation */
.nav-item {
  background: rgba(255,255,255,.018) !important;
  border: 1px solid transparent !important;
}

.nav-item:hover {
  background: rgba(255,255,255,.075) !important;
  border-color: rgba(255,255,255,.08) !important;
}

.nav-item.active {
  background: rgba(255,255,255,.095) !important;
  border-color: rgba(255,255,255,.12) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.08),
    0 8px 25px rgba(0,0,0,.12) !important;
}

/* Glass hero */
.hero {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.09),
      rgba(255,255,255,.035)
    ) !important;

  border: 1px solid var(--glass-border) !important;

  backdrop-filter: blur(30px) saturate(135%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(135%) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.08),
    0 25px 70px rgba(0,0,0,.22) !important;
}

/* Glass search */
.hero-search {
  background: rgba(255,255,255,.055) !important;
  border: 1px solid rgba(255,255,255,.13) !important;

  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.06) !important;
}

.hero-search:focus-within {
  background: rgba(255,255,255,.08) !important;
  border-color: rgba(255,255,255,.2) !important;
}

/* Glass music cards */
.music-card {
  padding: 8px !important;
  border: 1px solid transparent !important;
  border-radius: 16px !important;

  background: rgba(255,255,255,.025) !important;

  transition:
    background .2s ease,
    border-color .2s ease,
    transform .2s ease !important;
}

.music-card:hover {
  background: rgba(255,255,255,.065) !important;
  border-color: rgba(255,255,255,.1) !important;
  transform: translateY(-2px) !important;
}

.music-card strong,
.music-card > span {
  margin-left: 4px !important;
}

/* Glass search result rows */
.song-row {
  background: rgba(255,255,255,.025) !important;
  border: 1px solid transparent !important;
}

.song-row:hover {
  background: rgba(255,255,255,.07) !important;
  border-color: rgba(255,255,255,.09) !important;
}

/* Glass mood cards */
.mood-card {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    ) !important;

  border: 1px solid var(--glass-border) !important;

  backdrop-filter: blur(20px) saturate(130%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(130%) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.06) !important;
}

.mood-card:hover {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.11),
      rgba(255,255,255,.045)
    ) !important;

  border-color: rgba(255,255,255,.15) !important;
}

/* Glass player */
.player {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.045)
    ) !important;

  border: 1px solid rgba(255,255,255,.14) !important;

  backdrop-filter: blur(30px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(150%) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.09),
    0 25px 70px rgba(0,0,0,.45) !important;
}

/* Player buttons */
.player-buttons button:hover {
  background: rgba(255,255,255,.09) !important;
}

.player-buttons .play-button {
  background: rgba(255,255,255,.94) !important;
  box-shadow:
    0 8px 25px rgba(0,0,0,.2),
    inset 0 1px rgba(255,255,255,.5) !important;
}

/* Glass player action buttons */
.lyrics-button {
  background: rgba(255,255,255,.045) !important;
  border: 1px solid rgba(255,255,255,.1) !important;

  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
}

.lyrics-button:hover,
.lyrics-button.active {
  background: rgba(255,255,255,.1) !important;
  border-color: rgba(255,255,255,.15) !important;
}

/* Glass volume */
.player-volume {
  padding: 7px 10px !important;
  border-radius: 10px !important;

  background: rgba(255,255,255,.045) !important;
  border: 1px solid rgba(255,255,255,.08) !important;
}

/* Queue glass */
.queue-panel {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.045)
    ) !important;

  border: 1px solid rgba(255,255,255,.14) !important;

  backdrop-filter: blur(30px) saturate(145%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(145%) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.08),
    0 25px 70px rgba(0,0,0,.5) !important;
}

.queue-item:hover {
  background: rgba(255,255,255,.065) !important;
}

/* Lyrics glass */
.lyrics-panel {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.04)
    ) !important;

  border: 1px solid rgba(255,255,255,.14) !important;

  backdrop-filter: blur(30px) saturate(145%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(145%) !important;

  box-shadow:
    inset 0 1px rgba(255,255,255,.08),
    0 25px 70px rgba(0,0,0,.5) !important;
}

/* Glass close buttons */
.queue-close:hover,
.lyrics-close:hover {
  background: rgba(255,255,255,.08) !important;
}

/* Glass dividers */
.sidebar-divider {
  background: rgba(255,255,255,.08) !important;
}

/* Slight glass effect on section containers */
.section {
  position: relative;
}

/* Smooth everything */
.hero,
.music-card,
.mood-card,
.song-row,
.player,
.queue-panel,
.lyrics-panel,
.nav-item {
  isolation: isolate;
}

/* Mobile glass */
@media (max-width: 650px) {
  .player {
    background:
      linear-gradient(
        135deg,
        rgba(255,255,255,.11),
        rgba(255,255,255,.045)
      ) !important;

    backdrop-filter: blur(25px) saturate(145%) !important;
    -webkit-backdrop-filter: blur(25px) saturate(145%) !important;
  }
}


/* =========================================================
   AURALIS — CLEAN WATER GLASS UI
   ========================================================= */

:root {
  --glass: rgba(255,255,255,.055);
  --glass-hover: rgba(255,255,255,.085);
  --glass-border: rgba(255,255,255,.11);
  --glass-highlight: rgba(255,255,255,.16);
}

/* Main background */
html,
body {
  background:
    radial-gradient(circle at 15% 10%, rgba(120,120,255,.07), transparent 32%),
    radial-gradient(circle at 85% 20%, rgba(80,160,255,.05), transparent 30%),
    #09090b !important;
  color: var(--text);
}

/* Sidebar glass */
.sidebar {
  background: rgba(12,12,15,.72) !important;
  border-right: 1px solid var(--glass-border) !important;
  backdrop-filter: blur(28px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(140%) !important;
}

/* Topbar glass */
.topbar {
  background: rgba(9,9,11,.68) !important;
  border-bottom: 1px solid var(--glass-border) !important;
  backdrop-filter: blur(25px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(25px) saturate(140%) !important;
}

/* Navigation */
.nav-item {
  border: 1px solid transparent !important;
  border-radius: 12px !important;
  transition: background .2s ease, border-color .2s ease, transform .2s ease !important;
}

.nav-item:hover {
  background: var(--glass) !important;
  border-color: var(--glass-border) !important;
}

.nav-item.active {
  background: rgba(255,255,255,.09) !important;
  border-color: rgba(255,255,255,.13) !important;
}

/* Hero */
.hero {
  position: relative !important;
  overflow: hidden !important;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.09),
      rgba(255,255,255,.035)
    ) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 24px !important;
  backdrop-filter: blur(24px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(140%) !important;
  box-shadow:
    0 20px 60px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.08) !important;
}

/* Glass shine */
.hero::after,
.music-card::after,
.mood-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    120deg,
    rgba(255,255,255,.08),
    transparent 35%
  );
  opacity: .55;
}

/* Search */
.search,
.hero-search {
  background: rgba(255,255,255,.055) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 14px !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
}

.search:focus-within,
.hero-search:focus-within {
  border-color: rgba(255,255,255,.22) !important;
  box-shadow: 0 0 0 3px rgba(255,255,255,.045) !important;
}

/* Music cards */
.music-card {
  position: relative !important;
  overflow: hidden !important;
  background: rgba(255,255,255,.035) !important;
  border: 1px solid transparent !important;
  border-radius: 17px !important;
  padding: 10px !important;
  transition:
    transform .22s ease,
    background .22s ease,
    border-color .22s ease !important;
}

.music-card:hover {
  transform: translateY(-4px) !important;
  background: rgba(255,255,255,.065) !important;
  border-color: var(--glass-border) !important;
}

.card-image {
  border-radius: 12px !important;
  overflow: hidden !important;
}

/* Mood cards */
.mood-card {
  position: relative !important;
  overflow: hidden !important;
  background: rgba(255,255,255,.045) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 17px !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
  transition: transform .2s ease, background .2s ease !important;
}

.mood-card:hover {
  transform: translateY(-3px) !important;
  background: rgba(255,255,255,.075) !important;
}

/* Search results */
.song-row,
.result-card,
.song-card {
  background: rgba(255,255,255,.025) !important;
  border: 1px solid transparent !important;
  border-radius: 13px !important;
  transition:
    background .2s ease,
    border-color .2s ease !important;
}

.song-row:hover,
.result-card:hover,
.song-card:hover {
  background: rgba(255,255,255,.055) !important;
  border-color: var(--glass-border) !important;
}

/* =========================================================
   PLAYER — WATER GLASS
   ========================================================= */

.player {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.045)
    ) !important;

  border: 1px solid rgba(255,255,255,.14) !important;

  backdrop-filter: blur(30px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(160%) !important;

  box-shadow:
    0 18px 60px rgba(0,0,0,.45),
    inset 0 1px 0 rgba(255,255,255,.10) !important;
}

/* Player cover */
.player-cover {
  border: 1px solid rgba(255,255,255,.12) !important;
}

/* Player controls */
.player-buttons button,
.player-actions button {
  background: rgba(255,255,255,.035) !important;
  border: 1px solid transparent !important;
}

.player-buttons button:hover,
.player-actions button:hover {
  background: rgba(255,255,255,.09) !important;
  border-color: var(--glass-border) !important;
}

/* Main play */
.player-buttons .play-button {
  background: #fff !important;
  color: #08080a !important;
  border: none !important;
}

/* Volume glass */
.player-volume {
  background: rgba(255,255,255,.045) !important;
  border: 1px solid var(--glass-border) !important;
  backdrop-filter: blur(15px) !important;
}

/* =========================================================
   AUDIO VISUALIZER
   ========================================================= */

.sound-visualizer {
  width: 38px;
  height: 24px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;

  margin-left: 8px;
  opacity: .45;
}

.sound-visualizer span {
  display: block;
  width: 3px;
  height: 7px;

  border-radius: 99px;
  background: rgba(255,255,255,.8);

  transform-origin: center;
  animation: auralisVisualizer 1.1s ease-in-out infinite;
  animation-play-state: paused;
}

.sound-visualizer.playing span {
  animation-play-state: running;
}

.sound-visualizer span:nth-child(1) { animation-delay: -.9s; }
.sound-visualizer span:nth-child(2) { animation-delay: -.7s; }
.sound-visualizer span:nth-child(3) { animation-delay: -.5s; }
.sound-visualizer span:nth-child(4) { animation-delay: -.3s; }
.sound-visualizer span:nth-child(5) { animation-delay: -.6s; }
.sound-visualizer span:nth-child(6) { animation-delay: -.2s; }
.sound-visualizer span:nth-child(7) { animation-delay: -.8s; }
.sound-visualizer span:nth-child(8) { animation-delay: -.4s; }

@keyframes auralisVisualizer {
  0%, 100% {
    height: 5px;
    opacity: .35;
  }

  50% {
    height: 21px;
    opacity: .9;
  }
}

/* =========================================================
   LYRICS / QUEUE GLASS PANELS
   ========================================================= */

.lyrics-panel,
.queue-panel {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.105),
      rgba(255,255,255,.045)
    ) !important;

  border: 1px solid rgba(255,255,255,.14) !important;

  backdrop-filter: blur(30px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(150%) !important;

  box-shadow:
    0 25px 80px rgba(0,0,0,.5),
    inset 0 1px 0 rgba(255,255,255,.09) !important;
}

/* Lyrics */
.lyrics-line {
  color: rgba(255,255,255,.45) !important;
  text-shadow: none !important;
}

.lyrics-active {
  color: #fff !important;
  text-shadow: 0 0 18px rgba(255,255,255,.25) !important;
}

/* Queue items */
.queue-item {
  background: rgba(255,255,255,.025) !important;
  border: 1px solid transparent !important;
  border-radius: 12px !important;
}

.queue-item:hover {
  background: rgba(255,255,255,.065) !important;
  border-color: var(--glass-border) !important;
}

/* Buttons */
button {
  font-family: inherit;
}

button:focus-visible {
  outline: 2px solid rgba(255,255,255,.3) !important;
  outline-offset: 2px;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,.12);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255,255,255,.2);
}

/* Mobile */
@media (max-width: 650px) {
  .hero {
    border-radius: 18px !important;
  }

  .music-card,
  .mood-card {
    border-radius: 14px !important;
  }

  .sound-visualizer {
    display: none;
  }
}


/* =========================================================
   AURALIS — AUDIO VISUALIZER
   ========================================================= */

.sound-visualizer {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 3px !important;
  width: 42px !important;
  height: 28px !important;
  margin-left: 8px !important;
  flex-shrink: 0 !important;
}

.sound-visualizer span {
  display: block !important;
  width: 3px !important;
  height: 7px !important;
  border-radius: 999px !important;
  background: rgba(255,255,255,.75) !important;
  transform-origin: center !important;
  animation: auralis-bars 1s ease-in-out infinite !important;
  animation-play-state: paused !important;
}

.sound-visualizer.playing span {
  animation-play-state: running !important;
}

.sound-visualizer span:nth-child(1) {
  animation-delay: -.8s !important;
}

.sound-visualizer span:nth-child(2) {
  animation-delay: -.6s !important;
}

.sound-visualizer span:nth-child(3) {
  animation-delay: -.4s !important;
}

.sound-visualizer span:nth-child(4) {
  animation-delay: -.2s !important;
}

.sound-visualizer span:nth-child(5) {
  animation-delay: -.5s !important;
}

.sound-visualizer span:nth-child(6) {
  animation-delay: -.3s !important;
}

.sound-visualizer span:nth-child(7) {
  animation-delay: -.7s !important;
}

.sound-visualizer span:nth-child(8) {
  animation-delay: -.1s !important;
}

@keyframes auralis-bars {
  0%, 100% {
    height: 5px;
    opacity: .35;
  }

  50% {
    height: 23px;
    opacity: 1;
  }
}


.player-volume {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
}

.sound-visualizer {
  display: flex !important;
}

@media (max-width: 650px) {
  .sound-visualizer {
    display: none !important;
  }
}


/* =========================================================
   AURALIS — ROTATING CD
   ========================================================= */

.player-cover {
  position: relative !important;
  overflow: hidden !important;
  border-radius: 50% !important;
  flex-shrink: 0 !important;
}

.player-cover img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  border-radius: 50% !important;
}

/* CD center hole */
.player-cover::after {
  content: "" !important;
  position: absolute !important;
  width: 11px !important;
  height: 11px !important;
  left: 50% !important;
  top: 50% !important;
  transform: translate(-50%, -50%) !important;
  border-radius: 50% !important;
  background: #111113 !important;
  border: 2px solid rgba(255,255,255,.5) !important;
  box-shadow: 0 0 0 2px rgba(0,0,0,.35) !important;
  pointer-events: none !important;
  z-index: 2 !important;
}

/* Rotate only while playing */
.player-cover.playing img {
  animation: auralis-cd-spin 8s linear infinite !important;
}

@keyframes auralis-cd-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}


.player-cover {
  width: 58px !important;
  height: 58px !important;
  flex: 0 0 58px !important;
}


/* =========================================================
   AURALIS — LIBRARY
   ========================================================= */

.library-page {
  padding: 10px 0 140px;
}

.library-hero {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 28px;
  margin-bottom: 28px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 22px;
  background: rgba(255,255,255,.045);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.library-icon {
  width: 88px;
  height: 88px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 18px;
  background: rgba(255,255,255,.09);
  border: 1px solid rgba(255,255,255,.12);
  font-size: 34px;
}

.library-hero h1,
.library-heading h1 {
  margin: 5px 0;
  font-size: 32px;
  letter-spacing: -.04em;
}

.library-hero p,
.library-heading p {
  margin: 0;
  color: var(--muted);
}

.library-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.library-song {
  display: grid;
  grid-template-columns: 30px 48px minmax(0,1fr) auto auto;
  align-items: center;
  gap: 14px;
  padding: 9px 12px;
  border-radius: 13px;
  background: rgba(255,255,255,.025);
  border: 1px solid transparent;
  transition: .2s ease;
}

.library-song:hover {
  background: rgba(255,255,255,.06);
  border-color: rgba(255,255,255,.09);
}

.library-number {
  color: var(--muted);
  text-align: center;
  font-size: 12px;
}

.library-cover {
  width: 48px;
  height: 48px;
  overflow: hidden;
  border-radius: 9px;
}

.library-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.library-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: none;
  border: 0;
  color: inherit;
  cursor: pointer;
}

.library-info strong {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.library-info span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 12px;
}

.library-duration {
  color: var(--muted);
  font-size: 12px;
}

.library-heart {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 18px;
}

.library-heart:hover,
.library-heart.liked {
  color: #fff;
  background: rgba(255,255,255,.07);
}

.library-empty {
  padding: 80px 20px;
  text-align: center;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 20px;
  background: rgba(255,255,255,.025);
}

.library-empty > div {
  font-size: 42px;
  opacity: .5;
  margin-bottom: 12px;
}

.library-empty h2 {
  margin: 0 0 7px;
}

.library-empty p {
  margin: 0;
  color: var(--muted);
}

.library-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin: 25px 0 35px;
}

.library-stats > div {
  padding: 20px;
  border-radius: 16px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
}

.library-stats strong {
  display: block;
  font-size: 28px;
}

.library-stats span {
  color: var(--muted);
  font-size: 12px;
}

.library-subtitle {
  margin-bottom: 15px;
}

@media (max-width: 600px) {
  .library-song {
    grid-template-columns: 25px 44px minmax(0,1fr) auto;
  }

  .library-duration {
    display: none;
  }

  .library-hero {
    padding: 20px;
  }

  .library-icon {
    width: 65px;
    height: 65px;
  }
}


/* =========================================================
   AURALIS — LIBRARY / LIKED SONGS
   ========================================================= */

.library-page {
  padding: 10px 0 150px;
}

.library-hero {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 28px;
  margin-bottom: 26px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 22px;
  background: rgba(255,255,255,.045);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.library-icon {
  width: 76px;
  height: 76px;
  flex: 0 0 76px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  font-size: 30px;
  color: white;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.1);
  box-shadow: 0 12px 35px rgba(0,0,0,.25);
}

.library-hero h1 {
  margin: 5px 0 4px;
  font-size: 32px;
  letter-spacing: -.04em;
  color: #fff;
}

.library-hero p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.library-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.library-song {
  display: grid;
  grid-template-columns: 34px 52px minmax(0,1fr) auto auto;
  align-items: center;
  gap: 14px;
  padding: 9px 12px;
  border-radius: 13px;
  transition: background .18s ease;
}

.library-song:hover {
  background: rgba(255,255,255,.045);
}

.library-number {
  color: #66666e;
  font-size: 12px;
  text-align: center;
}

.library-cover {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  overflow: hidden;
  background: rgba(255,255,255,.06);
}

.library-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.library-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: 0;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.library-info strong {
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.library-info span {
  color: var(--muted);
  font-size: 11px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.library-duration {
  color: #66666e;
  font-size: 11px;
}

.library-remove {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #77777f;
  font-size: 18px;
  cursor: pointer;
}

.library-remove:hover {
  color: #fff;
  background: rgba(255,255,255,.07);
}

.library-empty {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 1px dashed rgba(255,255,255,.1);
  border-radius: 20px;
  background: rgba(255,255,255,.025);
}

.library-empty-icon {
  font-size: 34px;
  margin-bottom: 14px;
  color: #77777f;
}

.library-empty strong {
  color: #fff;
  font-size: 15px;
}

.library-empty span {
  margin-top: 6px;
  color: var(--muted);
  font-size: 12px;
}

@media (max-width: 650px) {
  .library-hero {
    padding: 20px;
  }

  .library-icon {
    width: 60px;
    height: 60px;
    flex-basis: 60px;
  }

  .library-hero h1 {
    font-size: 25px;
  }

  .library-song {
    grid-template-columns: 25px 46px minmax(0,1fr) auto;
    gap: 10px;
  }

  .library-cover {
    width: 46px;
    height: 46px;
  }

  .library-duration {
    display: none;
  }
}


/* =========================================================
   AURALIS — PLAYLISTS
   ========================================================= */

.playlist-actions {
  margin: 22px 0 32px;
}

.create-playlist-button {
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.07);
  color: white;
  padding: 12px 18px;
  border-radius: 14px;
  cursor: pointer;
  font-weight: 700;
  backdrop-filter: blur(20px);
  transition: .2s ease;
}

.create-playlist-button:hover {
  background: rgba(255,255,255,.13);
  transform: translateY(-1px);
}

.playlist-section {
  margin-bottom: 35px;
}

.playlist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
  margin-top: 15px;
}

.playlist-card {
  text-align: left;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 18px;
  padding: 18px;
  color: white;
  background: rgba(255,255,255,.045);
  backdrop-filter: blur(20px);
  cursor: pointer;
  transition: .2s ease;
}

.playlist-card:hover {
  background: rgba(255,255,255,.08);
  transform: translateY(-3px);
}

.playlist-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  margin-bottom: 14px;
  background: rgba(255,255,255,.1);
  font-size: 22px;
}

.playlist-card strong,
.playlist-card span {
  display: block;
}

.playlist-card span {
  color: var(--muted);
  margin-top: 5px;
  font-size: 13px;
}

.playlist-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(12px);
}

.playlist-modal {
  width: min(420px, calc(100vw - 30px));
  padding: 28px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 24px;
  background: rgba(20,20,23,.82);
  backdrop-filter: blur(30px);
  box-shadow: 0 25px 80px rgba(0,0,0,.5);
}

.playlist-modal h2 {
  margin: 8px 0 20px;
}

.playlist-modal input {
  width: 100%;
  border: 1px solid rgba(255,255,255,.1);
  outline: none;
  border-radius: 13px;
  padding: 13px 15px;
  background: rgba(255,255,255,.06);
  color: white;
  font-size: 15px;
}

.playlist-modal input:focus {
  border-color: rgba(255,255,255,.3);
}

.playlist-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.playlist-modal-actions button {
  border: 0;
  border-radius: 12px;
  padding: 10px 16px;
  background: rgba(255,255,255,.08);
  color: white;
  cursor: pointer;
}

.playlist-modal-actions .primary {
  background: white;
  color: black;
  font-weight: 700;
}


/* =========================================================
   PLAYLIST VIEW
   ========================================================= */

.playlist-back {
  border: 0;
  background: rgba(255,255,255,.06);
  color: #fff;
  padding: 10px 15px;
  border-radius: 12px;
  cursor: pointer;
  margin-bottom: 20px;
}

.playlist-back:hover {
  background: rgba(255,255,255,.1);
}

.playlist-remove {
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.04);
  color: #aaa;
  padding: 8px 12px;
  border-radius: 10px;
  cursor: pointer;
}

.playlist-remove:hover {
  color: #fff;
  background: rgba(255,255,255,.1);
}


/* Auralis song options */

.song-options {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 22px;
  cursor: pointer;
  padding: 6px 10px;
  border-radius: 8px;
}

.song-options:hover {
  background: rgba(255, 255, 255, 0.1);
}

.options-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.song-options-menu {
  width: 320px;
  max-width: calc(100vw - 32px);
  padding: 16px;
  border-radius: 18px;
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
}

.song-options-menu button {
  width: 100%;
  padding: 12px;
  margin-top: 5px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: white;
  text-align: left;
  cursor: pointer;
  font-size: 14px;
}

.song-options-menu button:hover {
  background: rgba(255, 255, 255, 0.1);
}

.options-title {
  padding: 8px 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.options-title span {
  opacity: 0.6;
  font-size: 13px;
}

.playlist-picker {
  max-height: 70vh;
  overflow-y: auto;
}

.playlist-option {
  display: flex !important;
  align-items: center;
  gap: 12px;
  text-align: left !important;
}

.playlist-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  flex-shrink: 0;
}

.playlist-option-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.playlist-option-info small {
  opacity: 0.5;
  font-size: 12px;
}

.create-playlist-option {
  margin-top: 12px !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  padding-top: 15px !important;
}

.empty-playlists {
  text-align: center;
  padding: 10px 0;
}

.empty-playlists p {
  opacity: 0.6;
  font-size: 14px;
  margin-bottom: 12px;
}

/* Premium Auralis Search */

.search-page {
  padding: 10px 0 30px;
}

.search-page-header {
  margin-bottom: 28px;
}

.search-page-header .section-label {
  letter-spacing: 2px;
  opacity: .55;
  font-size: 11px;
}

.search-page-header h2 {
  margin: 8px 0 6px;
  font-size: 34px;
  font-weight: 750;
  letter-spacing: -1px;
}

.search-page-header p {
  margin: 0;
  color: rgba(255,255,255,.5);
  font-size: 14px;
}

/* Search box */

.search-page-form {
  position: relative;
  width: min(760px, 100%);
  height: 64px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 7px 8px 7px 20px;

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.035)
    );

  border: 1px solid rgba(255,255,255,.12);

  box-shadow:
    0 15px 45px rgba(0,0,0,.25),
    inset 0 1px rgba(255,255,255,.06);

  backdrop-filter: blur(18px);

  transition:
    border-color .25s ease,
    box-shadow .25s ease,
    transform .25s ease;
}

.search-page-form::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: 20px;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,.18),
    transparent 35%,
    transparent 65%,
    rgba(255,255,255,.08)
  );
  opacity: .35;
}

.search-page-form:focus-within {
  border-color: rgba(255,255,255,.28);

  box-shadow:
    0 18px 55px rgba(0,0,0,.35),
    0 0 35px rgba(255,255,255,.055),
    inset 0 1px rgba(255,255,255,.1);

  transform: translateY(-1px);
}

/* Icon */

.search-page-icon {
  position: relative;
  z-index: 1;

  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background: rgba(255,255,255,.07);

  font-size: 25px;
  line-height: 1;

  color: rgba(255,255,255,.8);

  transition: transform .25s ease, background .25s ease;
}

.search-page-form:focus-within .search-page-icon {
  transform: scale(1.05);
  background: rgba(255,255,255,.11);
}

/* Input */

.search-page-form input {
  position: relative;
  z-index: 1;

  flex: 1;
  min-width: 0;

  height: 100%;

  border: 0;
  outline: 0;

  background: transparent;

  color: white;

  font-size: 16px;
  font-weight: 500;

  letter-spacing: .1px;
}

.search-page-form input::placeholder {
  color: rgba(255,255,255,.38);
}

/* Search button */

.search-page-form button {
  position: relative;
  z-index: 1;

  height: 48px;

  padding: 0 24px;

  border: 0;
  border-radius: 14px;

  cursor: pointer;

  background: white;
  color: #111;

  font-size: 14px;
  font-weight: 700;

  box-shadow:
    0 6px 20px rgba(0,0,0,.25);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.search-page-form button:hover {
  transform: translateY(-1px) scale(1.02);

  box-shadow:
    0 9px 28px rgba(0,0,0,.35);
}

.search-page-form button:active {
  transform: scale(.97);
}

/* Mobile */

@media (max-width: 600px) {
  .search-page-header h2 {
    font-size: 28px;
  }

  .search-page-form {
    height: 58px;
    padding-left: 12px;
    border-radius: 16px;
  }

  .search-page-icon {
    width: 38px;
    height: 38px;
  }

  .search-page-form button {
    height: 44px;
    padding: 0 15px;
  }
}


/* Small corner options button */

.song-row {
  position: relative;
}

.song-options {
  width: 30px;
  height: 30px;
  min-width: 30px;
  padding: 0 !important;
  margin-left: 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;
  border-radius: 8px;

  background: transparent;
  color: rgba(255,255,255,.5);

  font-size: 18px;
  line-height: 1;

  cursor: pointer;
  transition: .2s ease;
}

.song-options:hover {
  background: rgba(255,255,255,.09);
  color: white;
}

.song-options:active {
  transform: scale(.9);
}

/* Now Playing */

.now-playing-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.now-playing-info strong {
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-playing-info span {
  font-size: 12px;
  opacity: .55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* Current playing song */

.player-song {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  width: 260px;
}

.player-cover {
  width: 52px;
  height: 52px;
  min-width: 52px;
  border-radius: 8px;
  overflow: hidden;
  background: rgba(255,255,255,.08);
}

.player-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.player-song-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.player-song-info strong {
  display: block;
  max-width: 190px;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-song-info span {
  display: block;
  max-width: 190px;
  font-size: 12px;
  opacity: .55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* Rainbow current song title */

.player-song-info strong {
  background: linear-gradient(
    90deg,
    #ff4ecd,
    #7c5cff,
    #22d3ee,
    #4ade80,
    #facc15,
    #ff4ecd
  );
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: rainbowSongTitle 4s linear infinite;
}

@keyframes rainbowSongTitle {
  0% {
    background-position: 0% 50%;
  }
  100% {
    background-position: 300% 50%;
  }
}


.playlist-picker {
  width: 320px;
}

.playlist-picker > button {
  width: 100%;
  border: 0;
  padding: 12px 14px;
  margin-top: 6px;
  border-radius: 10px;
  background: rgba(255,255,255,.06);
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.playlist-picker > button:hover {
  background: rgba(255,255,255,.12);
}

.playlist-picker > button:disabled {
  opacity: .45;
  cursor: default;
}

.playlist-empty-picker {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px 0;
}

.playlist-empty-picker button {
  border: 0;
  padding: 10px;
  border-radius: 9px;
  cursor: pointer;
  background: rgba(255,255,255,.08);
  color: inherit;
}


.playlist-picker {
  width: 300px;
  max-width: calc(100vw - 32px);
}

.playlist-picker > button {
  width: 100%;
  border: 0;
  margin-top: 6px;
  padding: 11px 13px;
  border-radius: 9px;
  background: rgba(255,255,255,.06);
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.playlist-picker > button:hover {
  background: rgba(255,255,255,.12);
}

.playlist-picker > button:disabled {
  opacity: .45;
  cursor: default;
}

.playlist-picker-empty {
  padding: 14px 4px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  opacity: .7;
}

.playlist-picker-empty small {
  font-size: 11px;
  line-height: 1.5;
}

.playlist-picker-cancel {
  margin-top: 10px !important;
  background: rgba(255,255,255,.03) !important;
}


/* Song options */

.song-options {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 20px;
  cursor: pointer;
  padding: 5px 7px;
  border-radius: 7px;
  opacity: .7;
}

.song-options:hover {
  background: rgba(255,255,255,.09);
  opacity: 1;
}

.options-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.45);
  backdrop-filter: blur(5px);
}

.song-options-menu,
.playlist-picker {
  width: 280px;
  max-width: calc(100vw - 30px);
  padding: 10px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 14px;
  background: rgba(25,25,32,.97);
  box-shadow: 0 20px 60px rgba(0,0,0,.45);
}

.options-title {
  padding: 10px 11px 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.options-title strong {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.options-title span {
  font-size: 12px;
  opacity: .55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-options-menu > button,
.playlist-picker > button {
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  padding: 10px 11px;
  border-radius: 9px;
  text-align: left;
  cursor: pointer;
  font-size: 14px;
}

.song-options-menu > button:hover,
.playlist-picker > button:hover {
  background: rgba(255,255,255,.09);
}

.playlist-picker > button {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.playlist-picker > button span {
  font-size: 11px;
  opacity: .45;
}

.playlist-picker-empty {
  padding: 15px 11px;
  font-size: 13px;
  opacity: .55;
}

/* Rainbow current song title */

.player-song-info strong {
  background: linear-gradient(
    90deg,
    #ff4ecd,
    #7c5cff,
    #22d3ee,
    #4ade80,
    #facc15,
    #ff4ecd
  );
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: auralisRainbow 5s linear infinite;
}

@keyframes auralisRainbow {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 300% 50%;
  }
}

.search-page {
  padding: 10px 0 20px;
}

.search-page-heading h2 {
  margin: 6px 0;
  font-size: 28px;
}

.search-page-heading p {
  margin: 0;
  opacity: .55;
}

.search-page-bar {
  margin-top: 22px;
  max-width: 700px;
  height: 52px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px 0 16px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 14px;
  background: rgba(255,255,255,.055);
  box-shadow: 0 10px 35px rgba(0,0,0,.18);
}

.search-page-bar > span {
  font-size: 23px;
  opacity: .65;
}

.search-page-bar input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  font-size: 14px;
}

.search-page-bar input::placeholder {
  color: rgba(255,255,255,.4);
}

.search-page-bar button {
  border: 0;
  border-radius: 10px;
  padding: 10px 17px;
  background: rgba(255,255,255,.12);
  color: white;
  cursor: pointer;
  font-weight: 600;
}

.search-page-bar button:hover {
  background: rgba(255,255,255,.18);
}

/* Playlist selection */

.playlist-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 20px 0 12px;
  flex-wrap: wrap;
}

.playlist-select-all {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  cursor: pointer;
}

.playlist-select-all input,
.playlist-song-checkbox {
  width: 16px;
  height: 16px;
  accent-color: #8b5cf6;
  cursor: pointer;
}

.playlist-bulk-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.playlist-bulk-actions button {
  border: 0;
  border-radius: 9px;
  padding: 8px 12px;
  background: rgba(255,255,255,.08);
  color: white;
  cursor: pointer;
  font-size: 12px;
}

.playlist-bulk-actions button:hover {
  background: rgba(255,255,255,.14);
}

.playlist-song-checkbox {
  flex: 0 0 auto;
  margin-right: 4px;
}


.playlist-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 20px 0 12px;
  flex-wrap: wrap;
}

.playlist-select-all {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  cursor: pointer;
}

.playlist-select-all input,
.playlist-song-checkbox {
  width: 16px;
  height: 16px;
  accent-color: #8b5cf6;
  cursor: pointer;
}

.playlist-bulk-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.playlist-bulk-actions button {
  border: 0;
  border-radius: 9px;
  padding: 8px 12px;
  background: rgba(255,255,255,.08);
  color: white;
  cursor: pointer;
  font-size: 12px;
}

.playlist-bulk-actions button:hover {
  background: rgba(255,255,255,.14);
}

.playlist-song-checkbox {
  flex-shrink: 0;
}


/* Auralis Remove Confirmation */

.confirm-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, .68);
  backdrop-filter: blur(10px);
}

.confirm-modal {
  width: min(420px, 100%);
  padding: 28px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 22px;
  background: rgba(20, 20, 28, .96);
  box-shadow: 0 25px 80px rgba(0,0,0,.55);
  text-align: center;
  animation: confirmModalIn .18s ease-out;
}

.confirm-modal-icon {
  width: 52px;
  height: 52px;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 90, 90, .12);
  font-size: 25px;
}

.confirm-modal h2 {
  margin: 0 0 8px;
  font-size: 22px;
}

.confirm-modal p {
  margin: 0;
  color: rgba(255,255,255,.58);
  line-height: 1.6;
  font-size: 14px;
}

.confirm-modal-actions {
  display: flex;
  gap: 10px;
  margin-top: 24px;
}

.confirm-modal-actions button {
  flex: 1;
  height: 44px;
  border: 0;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: .15s ease;
}

.confirm-cancel {
  background: rgba(255,255,255,.08);
  color: white;
}

.confirm-remove {
  background: #ef4444;
  color: white;
}

.confirm-modal-actions button:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

@keyframes confirmModalIn {
  from {
    opacity: 0;
    transform: scale(.94) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

