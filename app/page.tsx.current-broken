"use client";
import { Heart, Shuffle, SkipBack, Play, Pause, SkipForward, Repeat, Music2, ListMusic, Volume2 } from "lucide-react";

import { FormEvent, useEffect, useRef, useState } from "react";
import YouTube, { YouTubePlayer } from "react-youtube";

type Song = {
  id: string;
  title: string;
  artist: string;
  album: string | null;
  thumbnail: string | null;
  duration: string | null;
};

const featured = [
  {
    title: "Believer",
    artist: "Imagine Dragons",
    image:
      "https://yt3.googleusercontent.com/weYQWfEwWNPOuAm34geXN1LkSYPlsJay78NnQgHC3PKsyZcdvBHIsMtqoFh3rioA4XgMdHMQd3h6vH6mbA=w500-h500-l90-rj",
  },
  {
    title: "Blinding Lights",
    artist: "The Weeknd",
    image:
      "https://i.ytimg.com/vi/4NRXx6U8ABQ/hqdefault.jpg",
  },
  {
    title: "Starboy",
    artist: "The Weeknd",
    image:
      "https://i.ytimg.com/vi/34Na4j8AVgA/hqdefault.jpg",
  },
  {
    title: "Heat Waves",
    artist: "Glass Animals",
    image:
      "https://i.ytimg.com/vi/mRD0-GxqHVo/hqdefault.jpg",
  },
];

export default function Home() {
  const [query, setQuery] = useState("");
  const [songs, setSongs] = useState<Song[]>([]);
  const [currentSong, setCurrentSong] = useState<Song | null>(null);
  const [playing, setPlaying] = useState(false);
  const [shuffle, setShuffle] = useState(false);
  const [repeat, setRepeat] = useState(false);
  const [liked, setLiked] = useState<string[]>([]);
  const [queue, setQueue] = useState<Song[]>([]);
  const queueRef = useRef<Song[]>([]);

  useEffect(() => {
    queueRef.current = queue;
  }, [queue]);
  const [draggedQueueIndex, setDraggedQueueIndex] = useState<number | null>(null);
  const [showQueue, setShowQueue] = useState(false);
  const [activeView, setActiveView] = useState<"home" | "search" | "liked" | "library" | "recent" | "made" | "albums">("home");
  const [recentlyPlayed, setRecentlyPlayed] = useState<Song[]>([]);
  const [activePlaylist, setActivePlaylist] = useState<string | null>(null);
  const [playlists, setPlaylists] = useState<
    { name: string; songs: Song[] }[]
  >([]);

  const [selectedPlaylist, setSelectedPlaylist] = useState<string | null>(null);
  const [showAddToPlaylist, setShowAddToPlaylist] = useState(false);
  const [songForPlaylist, setSongForPlaylist] = useState<Song | null>(null);
  const [selectedPlaylistSongs, setSelectedPlaylistSongs] = useState<string[]>([]);
  const [showMovePlaylist, setShowMovePlaylist] = useState(false);
  const [showRemoveConfirm, setShowRemoveConfirm] = useState(false);
  const [optionsSong, setOptionsSong] = useState<Song | null>(null);
  const [showCreatePlaylist, setShowCreatePlaylist] = useState(false);
  const [playlistName, setPlaylistName] = useState("");
  const [volume, setVolume] = useState(0.8);
  const [progress, setProgress] = useState(0);
  const [seeking, setSeeking] = useState(false);
  const [duration, setDuration] = useState(0);
  const [showLyrics, setShowLyrics] = useState(false);
  const [lyricsLoading, setLyricsLoading] = useState(false);
  const [lyricsError, setLyricsError] = useState(false);
  const [lyricsPosition, setLyricsPosition] = useState({
    x: 30,
    y: 120,
  });
  const [draggingLyrics, setDraggingLyrics] = useState(false);
  const [resizingPanel, setResizingPanel] = useState<string | null>(null);

  const resizeRef = useRef({
    panel: "",
    startX: 0,
    startY: 0,
    startWidth: 0,
    startHeight: 0,
    startLeft: 0,
    startTop: 0,
    direction: "",
  });

  function startPanelResize(
    e: React.PointerEvent,
    panel: "lyrics" | "queue",
    direction: string
  ) {
    e.preventDefault();
    e.stopPropagation();

    const element = e.currentTarget.parentElement;
    if (!element) return;

    const rect = element.getBoundingClientRect();

    resizeRef.current = {
      panel,
      startX: e.clientX,
      startY: e.clientY,
      startWidth: rect.width,
      startHeight: rect.height,
      startLeft: rect.left,
      startTop: rect.top,
      direction,
    };

    setResizingPanel(panel);

    const move = (event: PointerEvent) => {
      const r = resizeRef.current;

      let width = r.startWidth;
      let height = r.startHeight;
      let left = r.startLeft;
      let top = r.startTop;

      const dx = event.clientX - r.startX;
      const dy = event.clientY - r.startY;

      if (r.direction.includes("e")) {
        width = r.startWidth + dx;
      }

      if (r.direction.includes("w")) {
        width = r.startWidth - dx;
        left = r.startLeft + dx;
      }

      if (r.direction.includes("s")) {
        height = r.startHeight + dy;
      }

      if (r.direction.includes("n")) {
        height = r.startHeight - dy;
        top = r.startTop + dy;
      }

      width = Math.max(300, Math.min(width, window.innerWidth * 0.9));
      height = Math.max(260, Math.min(height, window.innerHeight * 0.85));

      const target = document.querySelector(
        r.panel === "lyrics" ? ".lyrics-panel" : ".queue-panel"
      ) as HTMLElement | null;

      if (!target) return;

        target.style.width = `${width}px`;
        target.style.height = `${height}px`;

        if (r.panel === "queue") {
          target.style.right = "650px";
          target.style.left = "auto";
          target.style.top = "auto";
          target.style.bottom = "105px";
        } else {
          target.style.right = "auto";
          target.style.bottom = "auto";
          target.style.left = `${left}px`;
          target.style.top = `${top}px`;

          setLyricsPosition({
            x: left,
            y: top,
          });
        }
    };

    const stop = () => {
      setResizingPanel(null);
      window.removeEventListener("pointermove", move);
      window.removeEventListener("pointerup", stop);
    };

    window.addEventListener("pointermove", move);
    window.addEventListener("pointerup", stop);
  }

  const lyricsDrag = useRef({
    startX: 0,
    startY: 0,
    startLeft: 0,
    startTop: 0,
  });
  const [lyrics, setLyrics] = useState<string[]>([
  ]);

  const LYRIC_OFFSET = 2.5; // seconds — increase if lyrics still show early
  const [syncedLyrics, setSyncedLyrics] = useState<
    { time: number; text: string }[]
  >([]);
  const [activeLyric, setActiveLyric] = useState(-1);
  const playerRef = useRef<YouTubePlayer | null>(null);
  const playingRef = useRef(false);
  const seekingRef = useRef(false);
  const visualProgressRef = useRef(0);
  const lastSyncTimeRef = useRef(0);
  const lastSyncAtRef = useRef(0);
  const lyricRefs = useRef<(HTMLDivElement | null)[]>([]);


  async function search(e?: FormEvent) {
    e?.preventDefault();

    if (!query.trim()) return;

    try {
      const response = await fetch(
        `/api/search?q=${encodeURIComponent(query)}`
      );

      const data = await response.json();

      if (response.ok) {
        setSongs(data.results || []);
      }
    } catch {
      console.error("Search failed");
    }
  }

  function playSong(song: Song) {
    if (currentSong?.id === song.id) {
      setPlaying((value) => !value);
      return;
    }

    setCurrentSong(song);
    setPlaying(true);

    setRecentlyPlayed((old) => [
      song,
      ...old.filter((item) => item.id !== song.id),
    ].slice(0, 20));
  }

  function createPlaylist() {
    const name = playlistName.trim();

    if (!name) return;

    setPlaylists((old) => {
      if (old.some((playlist) => playlist.name === name)) return old;
      return [...old, { name, songs: [] }];
    });

    setPlaylistName("");
    setShowCreatePlaylist(false);
  }

  function toggleLike(id: string) {
    setLiked((old) =>
      old.includes(id) ? old.filter((x) => x !== id) : [...old, id]
    );
  }

  function addToQueue(song: Song) {
    setQueue((old) => {
      if (old.some((item) => item.id === song.id)) {
        return old;
      }

      const updated = [...old, song];
      queueRef.current = updated;
      return updated;
    });
  }

  function removeFromQueue(id: string) {
    setQueue((old) => {
      const updated = old.filter((song) => song.id !== id);
      queueRef.current = updated;
      return updated;
    });
  }

  function clearQueue() {
    queueRef.current = [];
    setQueue([]);
  }

  function nextSong() {
    const currentQueue = queueRef.current;

    if (currentQueue.length > 0) {
      const [next, ...remaining] = currentQueue;

      queueRef.current = remaining;
      setQueue(remaining);

      setCurrentSong(next);
      setPlaying(true);

      return;
    }

    if (!currentSong || !songs.length) return;

    const index = songs.findIndex(
      (s) => s.id === currentSong.id
    );

    const next = songs[(index + 1) % songs.length];

    setCurrentSong(next);
    setPlaying(true);
  }

  function previousSong() {
    if (!currentSong || !songs.length) return;

    const index = songs.findIndex((s) => s.id === currentSong.id);
    const previous = songs[(index - 1 + songs.length) % songs.length];

    setCurrentSong(previous);
    setPlaying(true);
  }


  useEffect(() => {
    playingRef.current = playing;
  }, [playing]);

  // Keep the player state and song metadata synchronized.
  // Duration comes directly from the YouTube player, so it is also
  useEffect(() => {
    const player = playerRef.current;
    if (!player) return;

    setProgress(0);
    setDuration(0);

    let frame = 0;
    let lastRead = 0;
    let ended = false;

    const sync = () => {
      const currentPlayer = playerRef.current;

      if (!currentPlayer) {
        frame = requestAnimationFrame(sync);
        return;
      }

      const now = performance.now();

      if (now - lastRead >= 250) {
        lastRead = now;

        const time = currentPlayer.getCurrentTime();
        const realDuration = currentPlayer.getDuration();

        if (
          Number.isFinite(realDuration) &&
          realDuration > 0
        ) {
          setDuration(realDuration);

          const totalSeconds = Math.floor(realDuration);
          const hours = Math.floor(totalSeconds / 3600);
          const minutes = Math.floor(
            (totalSeconds % 3600) / 60
          );
          const seconds = totalSeconds % 60;

          const formattedDuration =
            hours > 0
              ? `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`
              : `${minutes}:${String(seconds).padStart(2, "0")}`;

          setCurrentSong((song) =>
            song
              ? { ...song, duration: formattedDuration }
              : song
          );

          setSongs((old) =>
            old.map((song) =>
              song.id === currentSong?.id
                ? { ...song, duration: formattedDuration }
                : song
            )
          );

          setRecentlyPlayed((old) =>
            old.map((song) =>
              song.id === currentSong?.id
                ? { ...song, duration: formattedDuration }
                : song
            )
          );

          setQueue((old) =>
            old.map((song) =>
              song.id === currentSong?.id
                ? { ...song, duration: formattedDuration }
                : song
            )
          );
        }

        if (Number.isFinite(time) && time >= 0) {
          setProgress(time);

          visualProgressRef.current = time;
          lastSyncTimeRef.current = time;
          lastSyncAtRef.current = now;

          if (syncedLyrics.length > 0) {
            let active = -1;

            for (let i = 0; i < syncedLyrics.length; i++) {
              if (time >= syncedLyrics[i].time) {
                active = i;
              } else {
                break;
              }
            }

            setActiveLyric(active);
          }

          if (
            playingRef.current &&
            realDuration > 0 &&
            time >= realDuration - 0.5
          ) {
            if (!ended) {
              ended = true;
              nextSong();
            }
          } else if (
            realDuration <= 0 ||
            time < realDuration - 1
          ) {
            ended = false;
          }
        }
      }

      if (
        playingRef.current &&
        !seekingRef.current &&
        lastSyncAtRef.current > 0
      ) {
        const elapsed =
          (now - lastSyncAtRef.current) / 1000;

        const visualTime =
          lastSyncTimeRef.current + elapsed;

        if (
          duration > 0 &&
          visualTime <= duration
        ) {
          setProgress(visualTime);
          visualProgressRef.current = visualTime;
        }
      }

      frame = requestAnimationFrame(sync);
    };

    frame = requestAnimationFrame(sync);

    return () => {
      cancelAnimationFrame(frame);
    };
  }, [currentSong?.id, syncedLyrics]);

  // Keep the active lyric centered while the song plays
  useEffect(() => {
    if (activeLyric < 0) return;

    const element = lyricRefs.current[activeLyric];
    if (!element) return;

    element.scrollIntoView({
      behavior: "instant",
      block: "center",
    });
  }, [activeLyric]);

  useEffect(() => {
    const player = playerRef.current;
    if (!player) return;

    if (playing) {
      player.playVideo();
    } else {
      player.pauseVideo();
    }
  }, [playing]);


  useEffect(() => {
    if (!currentSong || !showLyrics) return;

    const song = currentSong;
    let cancelled = false;

    setLyrics([]);
    setSyncedLyrics([]);
    setActiveLyric(-1);

    async function loadLyrics() {
      setLyricsLoading(true);
      setLyricsError(false);

      try {
        const cleanTitle = song.title
          .replace(/\([^)]*\)/g, "")
          .replace(/\[[^\]]*\]/g, "")
          .replace(/official video/gi, "")
          .replace(/official audio/gi, "")
          .replace(/lyrics?/gi, "")
          .replace(/x\s+.*$/i, "")
          .trim();

        const response = await fetch(
          `/api/lyrics?track=${encodeURIComponent(
            cleanTitle
          )}&artist=${encodeURIComponent(song.artist)}`
        );

        const data = await response.json();

        if (cancelled) return;

        if (
          (Array.isArray(data.lyrics) && data.lyrics.length > 0) ||
          (typeof data.syncedLyrics === "string" && data.syncedLyrics.trim().length > 0)
        ) {
          setLyrics(
            Array.isArray(data.lyrics) ? data.lyrics : []
          );

            // Parse synced LRC lyrics from the API
            if (typeof data.syncedLyrics === "string") {
              const parsed = data.syncedLyrics
                .split(/\r?\n/)
                .map((line: string) => {
                  const match = line.match(
                    /^\[(\d+):(\d+(?:\.\d+)?)\](?:\s*)(.*)$/
                  );

                  if (!match) return null;

                  return {
                    time:
                      Number(match[1]) * 60 +
                      Number(match[2]),
                    text: match[3].trim(),
                  };
                })
                .filter(
                  (
                    item: { time: number; text: string } | null
                  ): item is { time: number; text: string } =>
                    item !== null && item.text.length > 0
                );

              setSyncedLyrics(parsed);
              setActiveLyric(-1);
            } else {
              setSyncedLyrics([]);
              setActiveLyric(-1);
            }

          setLyricsError(false);
        } else {
          setLyrics([
            "No lyrics found for this song.",
            "Try another version of the track.",
          ]);
          setLyricsError(true);
        }
      } catch (error) {
        console.error("Lyrics loading failed:", error);

        if (!cancelled) {
          setLyricsError(true);
          setLyrics([
            "Couldn't load lyrics.",
            "Please try again.",
          ]);
        }
      } finally {
        if (!cancelled) {
          setLyricsLoading(false);
        }
      }
    }

    loadLyrics();

    return () => {
      cancelled = true;
    };
  }, [currentSong, showLyrics]);

  function startLyricsDrag(
    e: React.PointerEvent<HTMLDivElement>
  ) {
    if ((e.target as HTMLElement).closest(".lyrics-close")) {
      return;
    }

    e.preventDefault();
    e.stopPropagation();

    const panel = document.querySelector(
      ".lyrics-panel"
    ) as HTMLElement | null;

    if (!panel) return;

    const rect = panel.getBoundingClientRect();

    const startX = e.clientX;
    const startY = e.clientY;
    const startLeft = rect.left;
    const startTop = rect.top;

    setDraggingLyrics(true);

    const move = (event: PointerEvent) => {
      const x = startLeft + event.clientX - startX;
      const y = startTop + event.clientY - startY;

      panel.style.left = `${x}px`;
      panel.style.top = `${y}px`;
      panel.style.right = "auto";
      panel.style.bottom = "auto";
    };

    const stop = () => {
      const finalRect = panel.getBoundingClientRect();

      setLyricsPosition({
        x: finalRect.left,
        y: finalRect.top,
      });

      setDraggingLyrics(false);

      window.removeEventListener("pointermove", move);
      window.removeEventListener("pointerup", stop);
      window.removeEventListener("pointercancel", stop);
    };

    window.addEventListener("pointermove", move);
    window.addEventListener("pointerup", stop);
    window.addEventListener("pointercancel", stop);
  }

  function moveQueueItem(from: number, to: number) {
    if (from === to || from < 0 || to < 0) return;

    setQueue((old) => {
      if (from >= old.length || to >= old.length) return old;

      const updated = [...old];
      const [moved] = updated.splice(from, 1);
      updated.splice(to, 0, moved);

      return updated;
    });
  }

  return (

    <main>

      {optionsSong && (
        <div
          className="options-backdrop"
          onClick={() => setOptionsSong(null)}
        >
          <div
            className="song-options-menu"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="options-title">
              <strong>{optionsSong.title}</strong>
              <span>{optionsSong.artist}</span>
            </div>

            <button
              type="button"
              onClick={() => {
                playSong(optionsSong);
                setOptionsSong(null);
              }}
            >
              ▶ Play
            </button>

            <button
              type="button"
              onClick={() => {
                if (!queue.some((item) => item.id === optionsSong.id)) {
                  addToQueue(optionsSong);
                }
                setOptionsSong(null);
              }}
            >
              ＋ Add to queue
            </button>

            <button
              type="button"
              onClick={() => {
                setSongForPlaylist(optionsSong);
                setShowAddToPlaylist(true);
                setOptionsSong(null);
              }}
            >
              ♫ Add to playlist
            </button>

            <button
              type="button"
              onClick={() => {
                toggleLike(optionsSong.id);
                setOptionsSong(null);
              }}
            >
              {liked.includes(optionsSong.id) ? "♥ Unlike" : "♡ Like"}
            </button>

            <button
              type="button"
              onClick={() => setOptionsSong(null)}
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      {showAddToPlaylist && songForPlaylist && (
        <div
          className="options-backdrop"
          onClick={() => {
            setShowAddToPlaylist(false);
            setSongForPlaylist(null);
          }}
        >
          <div
            className="playlist-picker"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="options-title">
              <strong>Add to playlist</strong>
              <span>{songForPlaylist.title}</span>
            </div>

            {playlists.length > 0 ? (
              playlists.map((playlist) => (
                <button
                  type="button"
                  key={playlist.name}
                  onClick={() => {
                    setPlaylists((old) =>
                      old.map((item) => {
                        if (item.name !== playlist.name) return item;

                        if (
                          item.songs.some(
                            (song) => song.id === songForPlaylist.id
                          )
                        ) {
                          return item;
                        }

                        return {
                          ...item,
                          songs: [...item.songs, songForPlaylist],
                        };
                      })
                    );

                    setShowAddToPlaylist(false);
                    setSongForPlaylist(null);
                  }}
                >
                  ♫ {playlist.name}
                  <span>{playlist.songs.length} songs</span>
                </button>
              ))
            ) : (
              <div className="playlist-picker-empty">
                No playlists yet.
              </div>
            )}

            <button
              type="button"
              onClick={() => {
                setShowAddToPlaylist(false);
                setSongForPlaylist(null);
              }}
            >
              Cancel
            </button>
          </div>
        </div>
      )}



        <aside className="sidebar">
          <div className="logo">
            <div className="logo-mark">A</div>
            <div>
              <strong>AURALIS</strong>
              <span>MUSIC</span>
            </div>
          </div>

          <div className="menu-title">MENU</div>

          <nav>
            <button
              className={`nav-item ${activeView === "home" ? "active" : ""}`}
              onClick={() => setActiveView("home")}
            >
              <span className="nav-icon">⌂</span>
              <span>Home</span>
            </button>

            <button
              className={`nav-item ${activeView === "search" ? "active" : ""}`}
              onClick={() => setActiveView("search")}
            >
              <span className="nav-icon">⌕</span>
              <span>Search</span>
            </button>

            <button
              className={`nav-item ${activeView === "liked" ? "active" : ""}`}
              onClick={() => setActiveView("liked")}
            >
              <span className="nav-icon">♡</span>
              <span>Liked Songs</span>
            </button>

            <button
              className={`nav-item ${activeView === "library" ? "active" : ""}`}
              onClick={() => setActiveView("library")}
            >
              <span className="nav-icon">▣</span>
              <span>Library</span>
            </button>
          </nav>

          <div className="sidebar-divider" />

          <div className="menu-title">YOUR MUSIC</div>

          <nav>
            <button
              className={`nav-item ${activeView === "recent" ? "active" : ""}`}
              onClick={() => setActiveView("recent")}
            >
              <span className="nav-icon">♫</span>
              <span>Recently Played</span>
            </button>

            <button
              className={`nav-item ${activeView === "made" ? "active" : ""}`}
              onClick={() => setActiveView("made")}
            >
              <span className="nav-icon">✦</span>
              <span>Made For You</span>
            </button>

            <button
              className={`nav-item ${activeView === "albums" ? "active" : ""}`}
              onClick={() => setActiveView("albums")}
            >
              <span className="nav-icon">◉</span>
              <span>Albums</span>
            </button>
          </nav>

          <div className="sidebar-bottom">
            <div className="mini-badge">✦</div>
            <div>
              <b>Auralis Music</b>
              <span>Premium sound.</span>
            </div>
          </div>
        </aside>

      <section className="content">
        <header className="topbar">
          <div>
            <div className="eyebrow">AURALIS MUSIC ENGINE</div>
            <h1>Premium sound.</h1>
            <p className="subtitle">
              Discover music without limits.
            </p>
          </div>


        </header>

        <section className="hero">
          <div className="hero-glow" />

          <div className="hero-text">
            <span className="hero-label">✦ MUSIC FOR EVERY MOMENT</span>
            <h2>Find your<br />next favorite.</h2>
            <p>Search, discover and listen to music that matches your atmosphere.</p>

            <button
              className="hero-action"
              type="button"
              onClick={() => setActiveView("search")}
            >
              Start listening <span>→</span>
            </button>
          </div>

          <div className="hero-art">
            <div className="hero-orbit orbit-one" />
            <div className="hero-orbit orbit-two" />

            <div className="disc">
              <div className="disc-ring" />
              <div className="disc-center">✦</div>
            </div>
          </div>
        </section>

        {activeView === "search" && (
          <section className="search-page">
            <div className="search-page-heading">
              <span className="section-label">AURALIS SEARCH</span>
              <h2>Find your music</h2>
              <p>Search millions of songs and discover your next favorite sound.</p>
            </div>

            <form className="search-page-bar" onSubmit={search}>
              <span>⌕</span>
              <input
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="What do you want to listen to?"
              />
              <button type="submit">Search</button>
            </form>
          </section>
        )}

        {activeView === "search" && songs.length > 0 && (
          <section className="section">
            <div className="section-heading">
              <div>
                <span className="section-label">SEARCH RESULTS</span>
                <h2>Results for “{query}”</h2>
              </div>
              <span>{songs.length} songs</span>
            </div>

            <div className="song-list">
              {songs.map((song, index) => (
                <div
                  className={`song-row ${
                    currentSong?.id === song.id ? "selected" : ""
                  }`}
                  key={song.id}
                >
                  <span className="song-number">{index + 1}</span>

                  <div
                    className="song-cover"
                    onClick={() => playSong(song)}
                  >
                    {song.thumbnail && (
                      <img src={song.thumbnail} alt="" />
                    )}

                    <div className="cover-play">
                      {currentSong?.id === song.id && playing
                        ? "Ⅱ"
                        : "▶"}
                    </div>
                  </div>

                  <div
                    className="song-info"
                    onClick={() => playSong(song)}
                  >
                    <strong>{song.title}</strong>
                    <span>{song.artist}</span>
                  </div>

                  <div className="song-album">
                    {song.album || "Single"}
                  </div>

                  <div className="song-duration">
                    {song.duration || "--:--"}
                  </div>

                  <button
                      type="button"
                      className={`queue-add ${
                        queue.some((item) => item.id === song.id)
                          ? "queue-added"
                          : ""
                      }`}
                      title={
                        queue.some((item) => item.id === song.id)
                          ? "Already in queue"
                          : "Add to queue"
                      }
                      onPointerDown={(e) => e.stopPropagation()}
                      onClick={(e) => {
                        e.preventDefault();
                        e.stopPropagation();

                        if (!queue.some((item) => item.id === song.id)) {
                          addToQueue(song);
                        }
                      }}
                    >
                      {queue.some((item) => item.id === song.id) ? "✓" : "＋"}
                    </button>

                  <button
                    className={`like ${
                      liked.includes(song.id) ? "liked" : ""
                    }`}
                    onClick={() => toggleLike(song.id)}
                  >
                    {liked.includes(song.id) ? "♥" : "♡"}
                  </button>

                  <button
                    type="button"
                    className="song-options"
                    title="More options"
                    onPointerDown={(e) => e.stopPropagation()}
                    onClick={(e) => {
                      e.preventDefault();
                      e.stopPropagation();
                      setOptionsSong(song);
                    }}
                  >
                    ⋮
                  </button>
                </div>
              ))}
            </div>
          </section>
        )}

        {activeView === "liked" && (
          <section className="library-page">
            <div className="library-hero">
              <div className="library-icon">♥</div>
              <div>
                <span className="section-label">YOUR MUSIC</span>
                <h1>Liked Songs</h1>
                <p>{liked.length} songs you love</p>
              </div>
            </div>

            {liked.length > 0 ? (
              <div className="library-list">
                {songs
                  .filter((song) => liked.includes(song.id))
                  .map((song, index) => (
                    <div className="library-song" key={song.id}>
                      <span className="library-number">
                        {index + 1}
                      </span>

                      <div className="library-cover">
                        {song.thumbnail && (
                          <img src={song.thumbnail} alt="" />
                        )}
                      </div>

                      <button
                        className="library-info"
                        onClick={() => playSong(song)}
                      >
                        <strong>{song.title}</strong>
                        <span>{song.artist}</span>
                      </button>

                      <span className="library-duration">
                        {song.duration || "--:--"}
                      </span>

                      <button
                        className="library-heart liked"
                        onClick={() => toggleLike(song.id)}
                      >
                        ♥
                      </button>
                    </div>
                  ))}
              </div>
            ) : (
              <div className="library-empty">
                <div>♡</div>
                <h2>No liked songs yet</h2>
                <p>Tap the heart on a song to save it here.</p>
              </div>
            )}
          </section>
        )}

        {activeView === "recent" && (
          <section className="library-page">
            <div className="library-heading">
              <span className="section-label">YOUR MUSIC</span>
              <h1>Recently Played</h1>
              <p>Your latest listening history.</p>
            </div>

            {recentlyPlayed.length > 0 ? (
              <div className="library-list">
                {recentlyPlayed.map((song, index) => (
                  <div className="library-song" key={song.id}>
                    <span className="library-number">
                      {index + 1}
                    </span>

                    <div className="library-cover">
                      {song.thumbnail && (
                        <img src={song.thumbnail} alt="" />
                      )}
                    </div>

                    <button
                      className="library-info"
                      onClick={() => playSong(song)}
                    >
                      <strong>{song.title}</strong>
                      <span>{song.artist}</span>
                    </button>

                    <span className="library-duration">
                      {song.duration || "--:--"}
                    </span>
                  </div>
                ))}
              </div>
            ) : (
              <div className="library-empty">
                <div>♫</div>
                <h2>Nothing played yet</h2>
                <p>Start listening and your recent songs will appear here.</p>
              </div>
            )}
          </section>
        )}

        {activeView === "library" && activePlaylist && (
          <section className="library-page">
            <button
              className="playlist-back"
              onClick={() => {
  setActivePlaylist(null);
  setActiveView("library");
}}
            >
              ← Back to Library
            </button>

            {(() => {
              const playlist = playlists.find(
                (item) => item.name === activePlaylist
              );

              if (!playlist) return null;

              return (
                <>
                  <div className="library-hero">
                    <div className="library-icon">♫</div>
                    <div>
                      <span className="section-label">PLAYLIST</span>
                      <h1>{playlist.name}</h1>
                      <p>{playlist.songs.length} songs</p>
                    </div>
                  </div>

                  {playlist.songs.length > 0 ? (
                    <>
                      <div className="playlist-toolbar">
                        <label className="playlist-select-all">
                          <input
                            type="checkbox"
                            checked={
                              selectedPlaylistSongs.length ===
                              playlist.songs.length
                            }
                            onChange={(e) => {
                              if (e.target.checked) {
                                setSelectedPlaylistSongs(
                                  playlist.songs.map((song) => song.id)
                                );
                              } else {
                                setSelectedPlaylistSongs([]);
                              }
                            }}
                          />
                          <span>Select all</span>
                        </label>

                        {selectedPlaylistSongs.length > 0 && (
                          <div className="playlist-bulk-actions">
                            <button
                              type="button"
                              onClick={() => {
                                setShowRemoveConfirm(true);
                              }}
                            >
                              🗑 Remove
                            </button>

                            <button
                              type="button"
                              onClick={() => setShowMovePlaylist(true)}
                            >
                              📂 Move to playlist
                            </button>

                            <button
                              type="button"
                              onClick={() => {
                                const first = playlist.songs.find((song) =>
                                  selectedPlaylistSongs.includes(song.id)
                                );

                                setSongForPlaylist(first || null);
                                setShowAddToPlaylist(true);
                              }}
                            >
                              ＋ Add songs
                            </button>
                          </div>
                        )}
                      </div>

                      <div className="library-list">
                      {playlist.songs.map((song, index) => (
                        <div className="library-song" key={song.id}>
                          <input
                            type="checkbox"
                            className="playlist-song-checkbox"
                            checked={selectedPlaylistSongs.includes(song.id)}
                            onChange={(e) => {
                              if (e.target.checked) {
                                setSelectedPlaylistSongs((old) => [
                                  ...old,
                                  song.id,
                                ]);
                              } else {
                                setSelectedPlaylistSongs((old) =>
                                  old.filter((id) => id !== song.id)
                                );
                              }
                            }}
                            onClick={(e) => e.stopPropagation()}
                          />

                          <span className="library-number">
                            {index + 1}
                          </span>

                          <div className="library-cover">
                            {song.thumbnail && (
                              <img src={song.thumbnail} alt="" />
                            )}
                          </div>

                          <button
                            className="library-info"
                            onClick={() => playSong(song)}
                          >
                            <strong>{song.title}</strong>
                            <span>{song.artist}</span>
                          </button>

                          <span className="library-duration">
                            {song.duration || "--:--"}
                          </span>


                        </div>
                      ))}
                      </div>
                    </>
                  ) : (
                    <div className="library-empty">
                      <div>♫</div>
                      <h2>This playlist is empty</h2>
                      <p>Search for songs and add them to this playlist.</p>
                    </div>
                  )}
                </>
              );
            })()}
          </section>
        )}

        {activeView === "library" && !activePlaylist && (
          <section className="library-page">
            <div className="library-heading">
              <span className="section-label">YOUR MUSIC</span>
              <h1>Library</h1>
              <p>Your music, all in one place.</p>
            </div>

            <div className="playlist-actions">
              <button
                className="create-playlist-button"
                onClick={() => setShowCreatePlaylist(true)}
              >
                ＋ Create Playlist
              </button>
            </div>

            {playlists.length > 0 && (
              <div className="playlist-section">
                <span className="section-label">YOUR PLAYLISTS</span>

                <div className="playlist-grid">
                  {playlists.map((playlist) => (
                    <button
                      className="playlist-card"
                      key={playlist.name}
                      onClick={() => setActivePlaylist(playlist.name)}
                    >
                      <div className="playlist-icon">♫</div>
                      <strong>{playlist.name}</strong>
                      <span>{playlist.songs.length} songs</span>
                    </button>
                  ))}
                </div>
              </div>
            )}


          </section>
        )}

        {activeView === "home" && (
          <>
            <section className="section">
          <div className="section-heading">
            <div>
              <span className="section-label">DISCOVER</span>
              <h2>Popular right now</h2>
            </div>
            <span>Explore all →</span>
          </div>

          <div className="music-grid">
            {featured.map((item) => (
              <div className="music-card" key={item.title}>
                <div className="card-image">
                  <img src={item.image} alt="" />
                  <button
                    onClick={async () => {
                      setQuery(item.title);

                      try {
                        const response = await fetch(
                          `/api/search?q=${encodeURIComponent(
                            `${item.title} ${item.artist}`
                          )}`
                        );

                        const data = await response.json();
                        const results = data.results || [];

                        setSongs(results);

                        if (results.length > 0) {
                          playSong(results[0]);
                        }
                      } catch (error) {
                        console.error("Failed to play song:", error);
                      }
                    }}
                    className="card-play"
                  >
                    ▶
                  </button>
                </div>

                <strong>{item.title}</strong>
                <span>{item.artist}</span>
              </div>
            ))}
          </div>
        </section>

        <section className="section">
          <div className="section-heading">
            <div>
              <span className="section-label">MADE FOR YOU</span>
              <h2>Pick your atmosphere</h2>
            </div>
          </div>

          <div className="mood-grid">
            <div className="mood-card night">
              <span>☾</span>
              <div>
                <b>Night Drive</b>
                <small>Late night energy</small>
              </div>
            </div>

            <div className="mood-card energy">
              <span>ϟ</span>
              <div>
                <b>Energy</b>
                <small>Turn it up</small>
              </div>
            </div>

            <div className="mood-card chill">
              <span>☁</span>
              <div>
                <b>Chill</b>
                <small>Slow everything down</small>
              </div>
            </div>

            <div className="mood-card trending">
              <span>↗</span>
              <div>
                <b>Trending</b>
                <small>What's hot right now</small>
              </div>
            </div>
          </div>
        </section>
          </>
        )}

      </section>

      {showRemoveConfirm && activePlaylist && (
        <div
          className="confirm-modal-backdrop"
          onClick={() => setShowRemoveConfirm(false)}
        >
          <div
            className="confirm-modal"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="confirm-modal-icon">⚠</div>

            <h2>Remove songs?</h2>

            <p>
              Are you sure you want to remove{" "}
              <strong>{selectedPlaylistSongs.length} song(s)</strong>{" "}
              from <strong>{activePlaylist}</strong>?
            </p>

            <div className="confirm-modal-actions">
              <button
                type="button"
                className="confirm-cancel"
                onClick={() => setShowRemoveConfirm(false)}
              >
                Cancel
              </button>

              <button
                type="button"
                className="confirm-remove"
                onClick={() => {
                  setPlaylists((old) =>
                    old.map((item) =>
                      item.name === activePlaylist
                        ? {
                            ...item,
                            songs: item.songs.filter(
                              (song) =>
                                !selectedPlaylistSongs.includes(song.id)
                            ),
                          }
                        : item
                    )
                  );

                  setSelectedPlaylistSongs([]);
                  setShowRemoveConfirm(false);
                }}
              >
                Remove
              </button>
            </div>
          </div>
        </div>
      )}

      {showCreatePlaylist && (
        <div className="playlist-modal-backdrop">
          <div className="playlist-modal">
            <span className="section-label">YOUR MUSIC</span>

            <h2>Create Playlist</h2>

            <input
              autoFocus
              value={playlistName}
              onChange={(e) => setPlaylistName(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  createPlaylist();
                }
              }}
              placeholder="Playlist name"
            />

            <div className="playlist-modal-actions">
              <button
                onClick={() => {
                  setShowCreatePlaylist(false);
                  setPlaylistName("");
                }}
              >
                Cancel
              </button>

              <button
                className="primary"
                onClick={createPlaylist}
              >
                Create
              </button>
            </div>
          </div>
        </div>
      )}

      {showMovePlaylist && activePlaylist && (
        <div
          className="options-backdrop"
          onClick={() => setShowMovePlaylist(false)}
        >
          <div
            className="song-options-menu playlist-picker"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="options-title">
              <strong>Move songs</strong>
              <span>
                {selectedPlaylistSongs.length} selected
              </span>
            </div>

            {playlists
              .filter((playlist) => playlist.name !== activePlaylist)
              .map((targetPlaylist) => (
                <button
                  key={targetPlaylist.name}
                  type="button"
                  onClick={() => {
                    const confirmed = window.confirm(
                      `Move ${selectedPlaylistSongs.length} song(s) to "${targetPlaylist.name}"?`
                    );

                    if (!confirmed) return;

                    const currentPlaylist = playlists.find(
                      (p) => p.name === activePlaylist
                    );

                    const movingSongs =
                      currentPlaylist?.songs.filter((song) =>
                        selectedPlaylistSongs.includes(song.id)
                      ) || [];

                    setPlaylists((old) =>
                      old.map((item) => {
                        if (item.name === activePlaylist) {
                          return {
                            ...item,
                            songs: item.songs.filter(
                              (song) =>
                                !selectedPlaylistSongs.includes(song.id)
                            ),
                          };
                        }

                        if (item.name === targetPlaylist.name) {
                          const existing = new Set(
                            item.songs.map((song) => song.id)
                          );

                          return {
                            ...item,
                            songs: [
                              ...item.songs,
                              ...movingSongs.filter(
                                (song) => !existing.has(song.id)
                              ),
                            ],
                          };
                        }

                        return item;
                      })
                    );

                    setSelectedPlaylistSongs([]);
                    setShowMovePlaylist(false);
                  }}
                >
                  📂 {targetPlaylist.name}
                </button>
              ))}

            <button
              type="button"
              onClick={() => setShowMovePlaylist(false)}
            >
              Cancel
            </button>
          </div>
        </div>
      )}

      {showLyrics && currentSong && (
        <div
          className="lyrics-panel"
          style={{
            position: "fixed",
            left: `${lyricsPosition.x}px`,
            top: `${lyricsPosition.y}px`,
            right: "auto",
            bottom: "auto",
          }}
        >
          <div
            className="lyrics-header"
            onPointerDown={(e) => {
              if ((e.target as HTMLElement).closest("button")) return;
              startLyricsDrag(e);
            }}
            style={{
              cursor: draggingLyrics ? "grabbing" : "grab",
              touchAction: "none",
              userSelect: "none",
              WebkitUserSelect: "none",
            }}
          >
            <div>
              <span className="lyrics-label">
                NOW PLAYING
              </span>

              <h3>Lyrics</h3>

              <p>
                {currentSong.title}
              </p>
            </div>

          </div>

          <div className="lyrics-body">
            {lyricsLoading ? (
              <div className="lyrics-loading">
                <span className="lyrics-spinner" />
                Finding lyrics...
              </div>
            ) : lyricsError ? (
              <div className="lyrics-empty">
                Unable to load lyrics.
              </div>
            ) : lyrics.length ? (
                (syncedLyrics.length ? syncedLyrics : lyrics.map((text) => ({
                  time: 0,
                  text,
                }))).map((line, index) => (
                  <div
                      ref={(element) => {
                        lyricRefs.current[index] = element;
                      }}
                    key={`${line.text}-${index}`}
                    className={`lyrics-line ${
                      index === activeLyric ? "lyrics-active" : ""
                    }`}
                  >
                    {line.text}
                  </div>
                ))
            ) : (
              <div className="lyrics-empty">
                No lyrics available.
              </div>
            )}
          </div>

          {[
            ["n", "ns-resize"],
            ["s", "ns-resize"],
            ["e", "ew-resize"],
            ["w", "ew-resize"],
            ["ne", "nesw-resize"],
            ["sw", "nesw-resize"],
            ["nw", "nwse-resize"],
            ["se", "nwse-resize"],
          ].map(([direction, cursor]) => (
            <div
              key={direction}
              className={`panel-resize-handle resize-${direction}`}
              style={{
                cursor,
                zIndex: 20,
              }}
              onPointerDown={(e) =>
                startPanelResize(e, "lyrics", direction)
              }
            />
          ))}

          <div className="lyrics-footer">
            <button
              className={`lyrics-like ${
                liked.includes(currentSong.id)
                  ? "liked"
                  : ""
              }`}
              onClick={() =>
                toggleLike(currentSong.id)
              }
            >
              {liked.includes(currentSong.id)
                ? "♥ Liked"
                : "♡ Like"}
            </button>

            <span>✦ Auralis</span>
          </div>
        </div>
      )}

      {showQueue && (
        <div
          className="queue-panel"
          style={{
            position: "fixed",
            right: "40px",
            bottom: "110px",
            width: "380px",
            maxHeight: "520px",
            zIndex: 99999,
            display: "block",
            pointerEvents: "auto",
          }}
        >
          <div className="queue-header">
            <div>
              <span className="queue-label">PLAYING NEXT</span>
              <h3>Queue</h3>
            </div>

            <button
              type="button"
              className="queue-close"
              onClick={() => setShowQueue(false)}
            >
              ×
            </button>
          </div>

          <div className="queue-list">
            {queue.length > 0 ? (
              queue.map((song, index) => (
                <div
                  key={song.id}
                  className="queue-item"
                >
                  <span className="queue-number">
                    {index + 1}
                  </span>

                  <div className="queue-cover">
                    {song.thumbnail && (
                      <img src={song.thumbnail} alt="" />
                    )}
                  </div>

                  <button
                    type="button"
                    className="queue-info"
                    onClick={() => {
                      playSong(song);
                      setShowQueue(false);
                    }}
                  >
                    <strong>{song.title}</strong>
                    <span>{song.artist}</span>
                  </button>

                  <span className="queue-duration">
                    {song.duration || "--:--"}
                  </span>

                  <button
                    type="button"
                    className="queue-remove"
                    onClick={() => removeFromQueue(song.id)}
                    aria-label="Remove from queue"
                  >
                    ×
                  </button>
                </div>
              ))
            ) : (
              <div className="queue-empty">
                <div className="queue-empty-icon">☷</div>
                <strong>Your queue is empty</strong>
                <span>Add songs with the + button to see them here.</span>
              </div>
            )}
          </div>
        </div>
      )}
    </main>
  );
}
