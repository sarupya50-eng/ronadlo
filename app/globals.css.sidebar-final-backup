  opacity: 0;
  pointer-events: none;
  transition: opacity .22s ease;
}

.song-row:hover {
  transform: translateY(-2px);
  background: rgba(255,255,255,.055);
  border-color: rgba(255,255,255,.09);
  box-shadow: 0 14px 35px rgba(0,0,0,.25);
}

.song-row:hover::before {
  opacity: 1;
}

.song-row.selected {
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    );
  border-color: rgba(255,255,255,.12);
  box-shadow:
    inset 3px 0 0 #fff,
    0 12px 35px rgba(0,0,0,.25);
}

/* Number */

.song-number {
  position: relative;
  z-index: 2;
  color: #686870;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
}

.song-row:hover .song-number {
  color: #fff;
}

/* Artwork */

.song-cover {
  position: relative;
  z-index: 2;
  width: 58px;
  height: 58px;
  overflow: hidden;
  border-radius: 12px;
  cursor: pointer;
  background: linear-gradient(135deg,#252529,#101014);
  box-shadow: 0 8px 20px rgba(0,0,0,.35);
}

.song-cover::after {
  content: "▶";
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,.55);
  color: #fff;
  font-size: 16px;
  opacity: 0;
  transform: scale(.8);
  backdrop-filter: blur(3px);
  transition: .2s ease;
}

.song-row:hover .song-cover::after {
  opacity: 1;
  transform: scale(1);
}

.song-cover img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .35s cubic-bezier(.2,.8,.2,1);
}

.song-row:hover .song-cover img {
  transform: scale(1.1);
}

/* Playing artwork */

.song-row.selected .song-cover {
  box-shadow:
    0 0 0 2px rgba(255,255,255,.15),
    0 0 28px rgba(255,255,255,.12);
}

/* Song information */

.song-info {
  position: relative;
  z-index: 2;
  min-width: 0;
  cursor: pointer;
}

.song-info strong {
  display: block;
  overflow: hidden;
  color: #f4f4f5;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: color .2s ease;
}

.song-info span {
  display: block;
  overflow: hidden;
  margin-top: 5px;
  color: #777780;
  font-size: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.song-row:hover .song-info strong {
  color: #fff;
}

.song-row.selected .song-info strong {
  color: #fff;
}

/* Album */

.song-album {
  position: relative;
  z-index: 2;
  overflow: hidden;
  color: #777780;
  font-size: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Duration */

.song-duration {
  position: relative;
  z-index: 2;
  color: #686870;
  font-size: 12px;
  text-align: right;
}

/* Buttons */

.song-row button {
  position: relative;
  z-index: 5;
}

.song-row .song-like,
.song-row .song-options,
.song-row button {
  border: 0;
  outline: none;
  background: transparent;
}

.song-row .song-like,
.song-row .song-options {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  color: #65656d;
  font-size: 17px;
  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.song-row .song-like:hover,
.song-row .song-options:hover {
  background: rgba(255,255,255,.08);
  color: #fff;
  transform: scale(1.08);
}

.song-row .song-like.liked {
  color: #fff;
  text-shadow: 0 0 14px rgba(255,255,255,.45);
}

/* Queue button */

.song-row button:not(.song-like):not(.song-options) {
  color: #777780;
  transition: .2s ease;
}

.song-row button:not(.song-like):not(.song-options):hover {
  color: #fff;
  transform: scale(1.12);
}

/* Playing indicator */

.song-row.selected .song-cover::before {
  content: "";
  position: absolute;
  z-index: 6;
  left: 50%;
  bottom: 8px;
  width: 20px;
  height: 13px;
  transform: translateX(-50%);
  background:
    linear-gradient(
      90deg,
      transparent 0 10%,
      #fff 10% 22%,
      transparent 22% 34%,
      #fff 34% 46%,
      transparent 46% 58%,
      #fff 58% 70%,
      transparent 70%
    );
  animation: equalizer .8s ease-in-out infinite;
}

@keyframes equalizer {
  0%,100% {
    transform: translateX(-50%) scaleY(.55);
  }

  50% {
    transform: translateX(-50%) scaleY(1);
  }
}

/* Mobile */

@media (max-width: 800px) {
  .song-row {
    grid-template-columns: 36px 52px minmax(0,1fr) 38px;
    gap: 10px;
    padding: 7px 8px;
  }

  .song-cover {
    width: 52px;
    height: 52px;
  }

  .song-album,
  .song-duration {
    display: none;
  }

  .song-row .song-like,
  .song-row .song-options {
    width: 30px;
    height: 30px;
  }

  .song-row {
    grid-template-columns: 36px 52px minmax(0,1fr) 34px;
  }

  .song-row .song-like {
    display: none;
  }
}

