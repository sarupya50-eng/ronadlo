@import "tailwindcss";

:root {
  --bg: #09090b;
  --panel: #111113;
  --panel-hover: #18181b;
  --border: rgba(255,255,255,.08);
  --text: #f5f5f5;
  --muted: #8b8b93;
  --accent: #ffffff;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

body {
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 230px;
  padding: 26px 18px;
  background: #0d0d0f;
  border-right: 1px solid var(--border);
  z-index: 1000;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 10px 28px;
}

.logo-mark {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #fff;
  color: #09090b;
  font-size: 15px;
  font-weight: 800;
}

.logo strong,
.logo {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -.02em;
}

.menu-title {
  padding: 0 10px;
  margin: 14px 0 9px;
  color: #66666e;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 10px 11px;
  margin: 3px 0;
  border-radius: 9px;
  color: #8d8d95;
  text-decoration: none;
  font-size: 13px;
  transition: .18s ease;
}

.nav-item:hover {
  background: #171719;
  color: #fff;
}

.nav-item.active {
  background: #1d1d20;
  color: #fff;
}

.nav-icon {
  width: 18px;
  text-align: center;
  font-size: 15px;
}

.sidebar-divider {
  height: 1px;
  margin: 20px 10px;
  background: var(--border);
}

.sidebar-bottom {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 20px;
}

/* =========================
   MAIN CONTENT
========================= */

.content {
  margin-left: 230px;
  min-height: 100vh;
  padding: 30px 42px 150px;
  max-width: 1500px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30px;
}

.eyebrow,
.section-label,
.hero-label,
.lyrics-label,
.queue-label {
  color: #77777f;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .13em;
}

.topbar h1 {
  margin: 4px 0 0;
  font-size: 22px;
  letter-spacing: -.04em;
}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  min-height: 310px;
  padding: 42px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: #111113;
}

.hero-glow {
  position: absolute;
  width: 420px;
  height: 420px;
  right: -100px;
  top: -150px;
  border-radius: 50%;
  background: rgba(255,255,255,.035);
  filter: blur(40px);
  pointer-events: none;
}

.hero-text {
  position: relative;
  z-index: 2;
  max-width: 600px;
}

.hero h1 {
  margin: 12px 0;
  font-size: clamp(42px, 6vw, 72px);
  line-height: .95;
  letter-spacing: -.065em;
}

.hero .subtitle {
  max-width: 470px;
  margin: 0 0 25px;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.6;
}

.hero-search,
.search {
  display: flex;
  align-items: center;
}

.hero-search {
  width: min(470px, 100%);
  padding: 5px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #0b0b0d;
}

.hero-search input,
.search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #fff;
  padding: 12px;
  font-size: 13px;
}

.hero-search button,
.search button {
  border: 0;
  border-radius: 9px;
  padding: 10px 15px;
  background: #fff;
  color: #09090b;
  font-weight: 700;
}

.hero-art {
  position: absolute;
  right: 7%;
  width: 210px;
  height: 210px;
  display: grid;
  place-items: center;
}

.disc {
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle,
      #19191d 0,
      #19191d 5px,
      #0b0b0d 6px,
      #0b0b0d 9px
    );
  box-shadow: 0 25px 70px rgba(0,0,0,.55);
}

.disc-center {
  position: absolute;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  border: 12px solid #222228;
}

.cover-play,
.card-play {
  border: 0;
  background: #fff;
  color: #08080a;
}

/* =========================
   SECTIONS
========================= */

.section {
  margin-top: 48px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin: 5px 0 0;
  font-size: 22px;
  letter-spacing: -.04em;
}

.section-heading > span {
  color: #77777f;
  font-size: 12px;
}

/* =========================
   MUSIC CARDS
========================= */

.music-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.music-card {
  min-width: 0;
}

.card-image {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 14px;
  background: #151518;
}

.card-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .25s ease;
}

.music-card:hover .card-image img {
  transform: scale(1.035);
}

.card-play {
  position: absolute;
  right: 12px;
  bottom: 12px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  opacity: 0;
  transform: translateY(5px);
  transition: .2s ease;
}

.music-card:hover .card-play {
  opacity: 1;
  transform: translateY(0);
}

.music-card strong {
  display: block;
  margin-top: 11px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 13px;
}

.music-card > span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================
   SEARCH RESULTS
========================= */

.song-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.song-row {
  position: relative;
  display: grid !important;
  grid-template-columns: 38px 52px minmax(0,1fr) auto auto !important;
  align-items: center;
  gap: 13px;
  min-height: 62px;
  padding: 7px 12px;
  border-radius: 10px;
  transition: background .15s ease;
}

.song-row:hover {
  background: #151517;
}

.song-number {
  color: #55555d;
  font-size: 11px;
  text-align: center;
}

.song-cover {
  width: 52px;
  height: 52px;
  overflow: hidden;
  border-radius: 8px;
  background: #18181b;
}

.song-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.song-info {
  min-width: 0;
}

.song-info strong {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}

.song-info span,
.song-album,
.song-duration {
  color: var(--muted);
  font-size: 11px;
}

.song-info span {
  display: block;
  margin-top: 5px;
}

.song-row button {
  border: 0;
  background: transparent;
  color: #77777f;
}

.song-row button:hover {
  color: #fff;
}

/* =========================
   MOODS
========================= */

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.mood-card {
  min-height: 115px;
  display: flex;
  align-items: flex-end;
  gap: 12px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: #111113;
  transition: .2s ease;
}

.mood-card:hover {
  background: #18181b;
  transform: translateY(-2px);
}

.mood-card > span {
  font-size: 23px;
}

.mood-card b {
  display: block;
  font-size: 13px;
}

.mood-card small {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}


.lyrics-button {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px;
  background: transparent;
  color: #888890;
  font-size: 11px;
}

.lyrics-button:hover,
.lyrics-button.active {
  background: #1d1d20;
  color: #fff;
}




/* =========================
   QUEUE
========================= */

.queue-panel,
.lyrics-panel {
  position: fixed;
  z-index: 10001;
  background: #111113;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 16px;
  box-shadow: 0 25px 70px rgba(0,0,0,.55);
  overflow: hidden;
}

.queue-panel {
  right: 40px;
  bottom: 110px;
  width: 380px;
  max-height: 520px;
}

.queue-header,
.lyrics-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px;
  border-bottom: 1px solid var(--border);
}

.queue-header h3,
.lyrics-header h3 {
  margin: 5px 0 0;
  font-size: 16px;
}

.queue-close {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #888;
  font-size: 20px;
}

.queue-close:hover {
  background: #1c1c20;
  color: #fff;
}

.queue-list {
  max-height: 420px;
  overflow-y: auto;
  padding: 8px;
}

.queue-item {
  display: grid;
  grid-template-columns: 20px 20px 42px minmax(0,1fr) auto 25px;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border-radius: 9px;
}

.queue-item:hover {
  background: #19191c;
}

.queue-drag,
.queue-number {
  color: #66666e;
  font-size: 10px;
}

.queue-cover {
  width: 42px;
  height: 42px;
  overflow: hidden;
  border-radius: 7px;
}

.queue-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.queue-info {
  min-width: 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.queue-info strong,
.queue-info span {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.queue-info strong {
  color: #eee;
  font-size: 11px;
}

.queue-info span {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.queue-duration {
  color: #66666e;
  font-size: 9px;
}

.queue-remove {
  border: 0;
  background: transparent;
  color: #666;
  font-size: 17px;
}

.queue-empty {
  padding: 55px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.queue-empty-icon {
  margin-bottom: 12px;
  font-size: 30px;
  color: #555;
}

.queue-empty strong {
  font-size: 13px;
}

.queue-empty span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================
   LYRICS
========================= */

.lyrics-panel {
  width: 380px;
  max-width: 90vw;
  max-height: 80vh;
}

.lyrics-body {
  height: 380px;
  overflow-y: auto;
  padding: 20px;
  text-align: center;
}

.lyrics-line {
  margin: 14px 0;
  color: #77777f;
  font-size: 15px;
  line-height: 1.5;
  transition: .15s ease;
}

.lyrics-active {
  color: #fff !important;
  font-size: 20px !important;
  font-weight: 700;
}

.lyrics-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  color: #666;
  font-size: 10px;
}

.lyrics-like {
  border: 0;
  border-radius: 7px;
  padding: 7px 10px;
  background: #1c1c20;
  color: #aaa;
}

.lyrics-like.liked {
  color: #fff;
}

/* Resize handles */

.panel-resize-handle {
  position: absolute;
  z-index: 20;
}

.resize-n,
.resize-s {
  left: 10px;
  right: 10px;
  height: 8px;
}

.resize-n { top: -4px; }
.resize-s { bottom: -4px; }

.resize-e,
.resize-w {
  top: 10px;
  bottom: 10px;
  width: 8px;
}

.resize-e { right: -4px; }
.resize-w { left: -4px; }

.resize-ne,
.resize-nw,
.resize-se,
.resize-sw {
  width: 14px;
  height: 14px;
}

.resize-ne { right: -5px; top: -5px; }
.resize-nw { left: -5px; top: -5px; }
.resize-se { right: -5px; bottom: -5px; }
.resize-sw { left: -5px; bottom: -5px; }

/* =========================
   MOBILE
========================= */

@media (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }

  .content {
    margin-left: 190px;
    padding: 24px;
  }

  .hero-art {
    opacity: .4;
    right: 0;
  }

  .music-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .mood-grid {
    grid-template-columns: repeat(2, 1fr);
  }


}

@media (max-width: 650px) {
  .sidebar {
    display: none;
  }

  .content {
    margin-left: 0;
    padding: 18px 15px 130px;
  }

  .hero {
    min-height: 300px;
    padding: 28px;
  }

  .hero h1 {
    font-size: 42px;
  }

  .hero-art {
    display: none;
  }

  .music-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .mood-grid {
    grid-template-columns: 1fr 1fr;
  }

  .song-row {
    grid-template-columns: 28px 45px minmax(0,1fr) auto !important;
  }

  .song-cover {
    width: 45px;
    height: 45px;
  }

  .song-album {
    display: none;
  }




  .queue-panel {
    left: 10px;
    right: 10px;
    bottom: 100px;
    width: auto;
  }

  .lyrics-panel {
    left: 10px !important;
    right: 10px !important;
    width: auto !important;
  }
}

