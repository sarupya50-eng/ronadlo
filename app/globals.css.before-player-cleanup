/* Smooth Auralis progress bar */

.progress input[type="range"] {
  appearance: none;
  -webkit-appearance: none;
  height: 5px;
  border-radius: 999px;
  outline: none;
  background: linear-gradient(
    to right,
    rgba(255,255,255,.9) 0%,
    rgba(255,255,255,.9) var(--progress, 0%),
    rgba(255,255,255,.16) var(--progress, 0%),
    rgba(255,255,255,.16) 100%
  );
}

.progress input[type="range"]::-webkit-slider-runnable-track {
  height: 5px;
  border-radius: 999px;
  background: transparent;
}

.progress input[type="range"]::-webkit-slider-thumb {
  appearance: none;
  -webkit-appearance: none;
  width: 13px;
  height: 13px;
  margin-top: -4px;
  border: 0;
  border-radius: 50%;
  background: white;
  cursor: grab;
  box-shadow: 0 2px 10px rgba(0,0,0,.3);
  transition: transform .15s ease;
}

.progress input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.25);
}

.progress input[type="range"]::-moz-range-track {
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.16);
}

.progress input[type="range"]::-moz-range-progress {
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.9);
}

.progress input[type="range"]::-moz-range-thumb {
  width: 13px;
  height: 13px;
  border: 0;
  border-radius: 50%;
  background: white;
  cursor: grab;
}


/* Played = white, remaining = subtle */

.progress input[type="range"] {
  background: linear-gradient(
    to right,
    #fff 0%,
    #fff var(--progress, 0%),
    rgba(255,255,255,.16) var(--progress, 0%),
    rgba(255,255,255,.16) 100%
  ) !important;
}

.progress input[type="range"]::-webkit-slider-runnable-track {
  background: transparent;
}

.progress input[type="range"]::-webkit-slider-thumb {
  background: #fff;
  box-shadow:
    0 0 0 3px rgba(255,255,255,.08),
    0 2px 10px rgba(0,0,0,.35);
}

.progress input[type="range"]::-moz-range-progress {
  background: #fff;
}

.progress input[type="range"]::-moz-range-track {
  background: rgba(255,255,255,.16);
}


