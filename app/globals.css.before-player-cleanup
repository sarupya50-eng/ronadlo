/* Free resize support */
.lyrics-panel {
  position: fixed;
  min-width: 320px;
  min-height: 300px;
  max-width: 90vw;
  max-height: 85vh;
  overflow: hidden;
}

/* Keep normal content scrollable */
.lyrics-body {
  overflow-y: auto;
  overflow-x: hidden;
  scroll-behavior: smooth;
}

/* Native resize handle */
.lyrics-panel {
  resize: both;
}


.queue-panel {
  position: fixed;
  right: 28px;
  bottom: 105px;
  width: 380px;
  max-width: calc(100vw - 40px);
  max-height: 65vh;
  overflow: hidden;
  z-index: 1000;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: rgba(15,15,20,.96);
  backdrop-filter: blur(25px);
  box-shadow: 0 20px 60px rgba(0,0,0,.45);
}

.queue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.queue-label {
  font-size: 10px;
  letter-spacing: 2px;
  opacity: .5;
}

.queue-header h3 {
  margin: 4px 0 0;
  font-size: 22px;
}

.queue-close {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 25px;
  cursor: pointer;
  opacity: .6;
}

.queue-list {
  max-height: calc(65vh - 90px);
  overflow-y: auto;
  padding: 8px;
}

.queue-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.queue-item:hover {
  background: rgba(255,255,255,.07);
  transform: translateX(2px);
}

.queue-item.current {
  background: rgba(255,255,255,.1);
}

.queue-number {
  width: 22px;
  text-align: center;
  font-size: 12px;
  opacity: .55;
}

.queue-item.current .queue-number {
  opacity: 1;
}

.queue-cover {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 8px;
  overflow: hidden;
  background: rgba(255,255,255,.08);
}

.queue-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.queue-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.queue-info strong,
.queue-info span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.queue-info strong {
  font-size: 13px;
}

.queue-info span {
  font-size: 11px;
  opacity: .5;
}

.queue-duration {
  font-size: 11px;
  opacity: .45;
}

.queue-empty {
  padding: 35px 20px;
  text-align: center;
  opacity: .5;
}


/* Queue item hover lift */
.queue-item {
  transition:
    transform 0.22s cubic-bezier(.2,.8,.2,1),
    background 0.22s ease,
    box-shadow 0.22s ease;
}

.queue-item:hover {
  transform: translateY(-4px) scale(1.015);
  background: rgba(255,255,255,.08);
  box-shadow: 0 8px 24px rgba(0,0,0,.22);
}

.queue-item:active {
  transform: translateY(-1px) scale(.995);
}

.queue-cover {
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.queue-item:hover .queue-cover {
  transform: scale(1.04);
  box-shadow: 0 6px 18px rgba(0,0,0,.3);
}

.queue-item {
  position: relative;
  cursor: grab;
}

.queue-item:active {
  cursor: grabbing;
}

.queue-item.dragging {
  opacity: .45;
  transform: scale(.98);
}

.queue-drag {
  width: 14px;
  flex-shrink: 0;
  opacity: .25;
  font-size: 17px;
  cursor: grab;
}

.queue-item:hover .queue-drag {
  opacity: .7;
}

.queue-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  border: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.queue-remove {
  width: 26px;
  height: 26px;
  flex-shrink: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  font-size: 18px;
  opacity: 0;
  cursor: pointer;
  transition: opacity .2s ease, background .2s ease;
}

.queue-item:hover .queue-remove {
  opacity: .55;
}

.queue-remove:hover {
  opacity: 1 !important;
  background: rgba(255,255,255,.1);
}

.queue-empty {
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;
  padding: 30px;
  text-align: center;
}

.queue-empty-icon {
  font-size: 32px;
  opacity: .35;
}

.queue-empty strong {
  font-size: 14px;
}

.queue-empty span {
  font-size: 12px;
  opacity: .45;
}

/* Premium queue hover + drag animation */
.queue-item {
  transition:
    transform 180ms cubic-bezier(.2,.8,.2,1),
    background 180ms ease,
    box-shadow 180ms ease,
    opacity 180ms ease;
  will-change: transform;
}

.queue-item:hover {
  transform: translateY(-4px) scale(1.01);
  background: rgba(255,255,255,.06);
  box-shadow: 0 10px 28px rgba(0,0,0,.22);
}

.queue-item.dragging {
  transform: translateY(-7px) scale(1.02);
  opacity: .65;
  cursor: grabbing;
  box-shadow: 0 16px 35px rgba(0,0,0,.3);
}

.queue-item:active {
  cursor: grabbing;
}


/* Premium Queue Button */

.queue-add {
  width: 38px;
  height: 38px;
  flex-shrink: 0;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(255,255,255,.13);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.10),
      rgba(255,255,255,.035)
    );

  color: rgba(255,255,255,.72);
  font-size: 24px;
  font-weight: 300;
  line-height: 1;

  cursor: pointer;
  position: relative;
  z-index: 10;

  box-shadow:
    0 4px 12px rgba(0,0,0,.18),
    inset 0 1px rgba(255,255,255,.08);

  transition:
    transform .2s cubic-bezier(.2,.8,.2,1),
    background .2s ease,
    border-color .2s ease,
    color .2s ease,
    box-shadow .2s ease;
}

.queue-add::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(
    circle at center,
    rgba(255,255,255,.18),
    transparent 65%
  );
  opacity: 0;
  transform: scale(.5);
  transition: opacity .25s ease, transform .25s ease;
}

.queue-add:hover {
  transform: translateY(-2px) scale(1.06);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.17),
      rgba(255,255,255,.07)
    );

  border-color: rgba(255,255,255,.28);
  color: white;

  box-shadow:
    0 8px 22px rgba(0,0,0,.28),
    0 0 18px rgba(255,255,255,.06);
}

.queue-add:hover::before {
  opacity: 1;
  transform: scale(1);
}

.queue-add:active {
  transform: scale(.82);
  transition-duration: .08s;
}

/* Added state */

.queue-add.queue-added {
  border-color: rgba(80, 220, 150, .4);
  background:
    linear-gradient(
      145deg,
      rgba(80,220,150,.20),
      rgba(80,220,150,.07)
    );
  color: rgb(110, 240, 165);

  animation: queueAdded .38s cubic-bezier(.2,.8,.2,1);
}

.queue-add.queue-added:hover {
  border-color: rgba(110,240,165,.6);
  box-shadow:
    0 8px 22px rgba(0,0,0,.25),
    0 0 18px rgba(80,220,150,.12);
}

@keyframes queueAdded {
  0% {
    transform: scale(.65) rotate(-12deg);
    opacity: .4;
  }

  55% {
    transform: scale(1.18) rotate(4deg);
  }

  100% {
    transform: scale(1) rotate(0);
    opacity: 1;
  }
}


