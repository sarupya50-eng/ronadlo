      rgba(255,255,255,.35),
      #fff
    );

  transform: translateY(-50%);

  animation: queueEqualizer 1s ease-in-out infinite;
}

/* Extra bars using the number area */
.queue-item.current .queue-number {
  position: relative;
  color: transparent;
}

.queue-item.current .queue-number::before,
.queue-item.current .queue-number::after {
  content: "";
  position: absolute;
  bottom: 50%;
  width: 3px;
  border-radius: 99px;
  background: #fff;
  transform: translateY(50%);
}

.queue-item.current .queue-number::before {
  left: 6px;
  height: 9px;
  animation: queueBar1 .75s ease-in-out infinite;
}

.queue-item.current .queue-number::after {
  left: 12px;
  height: 14px;
  animation: queueBar2 .6s ease-in-out infinite;
}

@keyframes queueEqualizer {
  0%, 100% {
    height: 7px;
    opacity: .55;
  }

  50% {
    height: 18px;
    opacity: 1;
  }
}

@keyframes queueBar1 {
  0%, 100% {
    height: 6px;
  }

  50% {
    height: 15px;
  }
}

@keyframes queueBar2 {
  0%, 100% {
    height: 14px;
  }

  50% {
    height: 7px;
  }
}


/* ===== 360° SPINNING PLAYER VINYL ===== */

.player-cover {
  position: relative;
  width: 360px;
  height: 360px;

  flex-shrink: 0;

  border-radius: 50%;
  overflow: hidden;

  background: #111;

  box-shadow:
    0 18px 55px rgba(0,0,0,.45),
    0 0 0 1px rgba(255,255,255,.1);

  transform-origin: center;
}

/* Album artwork becomes the vinyl surface */
.player-cover img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
  border-radius: 50%;

  animation: vinylSpin 18s linear infinite;
  animation-play-state: paused;

  will-change: transform;
}

/* Make the image look like a real record */
.player-cover::before {
  content: "";

  position: absolute;
  inset: 0;

  z-index: 2;
  pointer-events: none;

  border-radius: 50%;

  background:
    repeating-radial-gradient(
      circle at center,
      transparent 0 17px,
      rgba(255,255,255,.035) 18px,
      transparent 19px 25px
    ),
    radial-gradient(
      circle at 50% 50%,
      transparent 0 7px,
      rgba(0,0,0,.35) 8px 10px,
      transparent 11px 100%
    );

  mix-blend-mode: overlay;
}

/* Center vinyl hole */
.player-cover::after {
  content: "";

  position: absolute;

  width: 18px;
  height: 18px;

  left: 50%;
  top: 50%;

  z-index: 4;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.5) 0 2px,
      #171717 3px 7px,
      rgba(255,255,255,.15) 8px,
      #080808 9px
    );

  box-shadow:
    0 0 0 5px rgba(0,0,0,.18),
    0 0 20px rgba(0,0,0,.4);
}

/* Playing state */
.player-cover.playing img {
  animation-play-state: running;
}

/* Smooth 360° rotation */
@keyframes vinylSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* Shine moving around the record */
.player-cover.playing {
  animation: vinylGlow 3s ease-in-out infinite alternate;
}

@keyframes vinylGlow {
  from {
    box-shadow:
      0 18px 55px rgba(0,0,0,.45),
      0 0 0 1px rgba(255,255,255,.08);
  }

  to {
    box-shadow:
      0 20px 65px rgba(0,0,0,.5),
      0 0 35px rgba(255,255,255,.08),
      0 0 0 1px rgba(255,255,255,.15);
  }
}

/* Smaller screens */
@media (max-width: 900px) {
  .player-cover {
    width: 220px;
    height: 220px;
  }
}

@media (max-width: 600px) {
  .player-cover {
    width: 150px;
    height: 150px;
  }
}


