/* =========================================================
   AURALIS — PREMIUM MOTION SYSTEM
   ========================================================= */

:root {
  --auralis-accent: #8b5cf6;
  --auralis-accent-2: #06b6d4;
  --auralis-pink: #ec4899;
}

/* ===== ANIMATED PAGE BACKGROUND ===== */

body {
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(139, 92, 246, .18),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 15%,
      rgba(6, 182, 212, .14),
      transparent 28%
    ),
    radial-gradient(
      circle at 70% 85%,
      rgba(236, 72, 153, .12),
      transparent 30%
    ),
    #07070b !important;

  background-size: 140% 140% !important;
  animation: auralisBackground 16s ease-in-out infinite alternate;
}

@keyframes auralisBackground {
  0% {
    background-position: 0% 0%;
  }

  50% {
    background-position: 100% 40%;
  }

  100% {
    background-position: 30% 100%;
  }
}

/* ===== FLOATING LIGHT ===== */

body::before,
body::after {
  content: "";
  position: fixed;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
  filter: blur(90px);
  opacity: .16;
}

body::before {
  left: -180px;
  top: 20%;
  background: var(--auralis-accent);
  animation: floatGlowOne 12s ease-in-out infinite alternate;
}

body::after {
  right: -180px;
  bottom: 10%;
  background: var(--auralis-accent-2);
  animation: floatGlowTwo 15s ease-in-out infinite alternate;
}

@keyframes floatGlowOne {
  0% {
    transform: translate(0, 0) scale(.8);
  }

  100% {
    transform: translate(180px, -80px) scale(1.2);
  }
}

@keyframes floatGlowTwo {
  0% {
    transform: translate(0, 0) scale(1);
  }

  100% {
    transform: translate(-160px, 80px) scale(1.25);
  }
}

/* ===== HERO GLOW ===== */

.hero {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.hero::before {
  content: "";
  position: absolute;
  width: 500px;
  height: 500px;
  left: 35%;
  top: -220px;

  background: conic-gradient(
    from 0deg,
    var(--auralis-accent),
    var(--auralis-accent-2),
    var(--auralis-pink),
    var(--auralis-accent)
  );

  filter: blur(100px);
  opacity: .18;
  border-radius: 50%;
  animation: heroOrb 10s linear infinite;
  z-index: -1;
}

@keyframes heroOrb {
  from {
    transform: rotate(0deg) scale(.9);
  }

  to {
    transform: rotate(360deg) scale(1.15);
  }
}

/* ===== HERO ART ===== */

.hero-art {
  animation: heroFloat 5s ease-in-out infinite;
}

@keyframes heroFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-12px) rotate(1deg);
  }
}

/* ===== DISC ===== */

.disc {
  box-shadow:
    0 0 40px rgba(139, 92, 246, .25),
    0 0 100px rgba(139, 92, 246, .12);

  animation:
    discSpin 14s linear infinite,
    discGlow 3s ease-in-out infinite alternate;
}

@keyframes discSpin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes discGlow {
  from {
    filter: drop-shadow(0 0 8px rgba(139, 92, 246, .15));
  }

  to {
    filter: drop-shadow(0 0 28px rgba(139, 92, 246, .4));
  }
}

/* ===== BUTTON MOTION ===== */

button {
  transition:
    transform .2s cubic-bezier(.2,.8,.2,1),
    box-shadow .2s ease,
    background .2s ease,
    border-color .2s ease !important;
}

button:hover {
  transform: translateY(-2px);
}

button:active {
  transform: scale(.94) translateY(1px);
}

/* ===== SEARCH ===== */

.search,
.hero-search {
  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;
}

.search:focus-within,
.hero-search:focus-within {
  transform: translateY(-2px);
  border-color: rgba(139, 92, 246, .55) !important;

  box-shadow:
    0 0 0 4px rgba(139, 92, 246, .08),
    0 15px 50px rgba(0, 0, 0, .25);
}

/* ===== SONG CARDS ===== */

.song-card {
  transition:
    transform .3s cubic-bezier(.2,.8,.2,1),
    border-color .3s ease,
    box-shadow .3s ease !important;
}

.song-card:hover {
  transform: translateY(-7px) scale(1.015);

  border-color: rgba(139, 92, 246, .35) !important;

  box-shadow:
    0 18px 45px rgba(0, 0, 0, .35),
    0 0 30px rgba(139, 92, 246, .08);
}

/* ===== SONG COVER ===== */

.song-card img {
  transition:
    transform .5s cubic-bezier(.2,.8,.2,1),
    filter .4s ease;
}

.song-card:hover img {
  transform: scale(1.08);
  filter: brightness(1.12) saturate(1.15);
}

/* ===== QUEUE ===== */

.queue-panel,
.lyrics-panel {
  animation: panelEnter .35s cubic-bezier(.2,.8,.2,1);
}

@keyframes panelEnter {
  from {
    opacity: 0;
    transform: translateY(15px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.queue-item {
  transition:
    transform .25s ease,
    background .25s ease,
    border-color .25s ease !important;
}

.queue-item:hover {
  transform: translateX(5px) !important;
  border-color: rgba(139, 92, 246, .2);
}

/* ===== PLAYER ===== */

.player {
  backdrop-filter: blur(30px) saturate(140%);
  -webkit-backdrop-filter: blur(30px) saturate(140%);

  box-shadow:
    0 -10px 50px rgba(0, 0, 0, .25),
    0 0 60px rgba(139, 92, 246, .06);
}

/* ===== PLAY BUTTON ===== */

.play-button {
  box-shadow:
    0 0 0 rgba(139, 92, 246, 0);

  transition:
    transform .2s ease,
    box-shadow .3s ease !important;
}

.play-button:hover {
  transform: scale(1.1) !important;

  box-shadow:
    0 0 25px rgba(139, 92, 246, .35),
    0 0 60px rgba(139, 92, 246, .12);
}

.play-button:active {
  transform: scale(.92) !important;
}

/* ===== CURRENT PLAYING GLOW ===== */

.player:has(.sound-visualizer.playing) {
  box-shadow:
    0 -10px 50px rgba(0, 0, 0, .3),
    0 0 80px rgba(139, 92, 246, .12);
}

/* ===== SMOOTH SCROLLBAR ===== */

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  border-radius: 99px;
  background: rgba(255,255,255,.15);
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(139,92,246,.5);
}

/* ===== TEXT SHIMMER ===== */

.hero-label,
.eyebrow {
  background: linear-gradient(
    90deg,
    #fff,
    #a78bfa,
    #67e8f9,
    #fff
  );

  background-size: 300% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;

  animation: textShimmer 5s linear infinite;
}

@keyframes textShimmer {
  to {
    background-position: 300% center;
  }
}


/* =========================================================
   AURALIS — AMBIENT PARTICLE FIELD
   ========================================================= */

.content {
  position: relative;
  isolation: isolate;
}

.content::before,
.content::after {
  content: "";
  position: fixed;
  pointer-events: none;
  z-index: -1;
  border-radius: 50%;
}

.content::before {
  width: 8px;
  height: 8px;
  left: 12%;
  top: 35%;

  background: rgba(167, 139, 250, .8);
  box-shadow:
    120px 80px rgba(103,232,249,.7),
    260px -60px rgba(236,72,153,.6),
    420px 160px rgba(139,92,246,.7),
    600px -20px rgba(103,232,249,.6),
    760px 220px rgba(236,72,153,.5),
    900px 40px rgba(167,139,250,.7);

  filter: blur(1px);
  animation: particlesFloat 9s ease-in-out infinite alternate;
}

.content::after {
  width: 5px;
  height: 5px;
  right: 15%;
  top: 55%;

  background: rgba(255,255,255,.7);
  box-shadow:
    -100px 100px rgba(139,92,246,.6),
    -230px -80px rgba(103,232,249,.6),
    -390px 180px rgba(236,72,153,.5),
    -520px -40px rgba(167,139,250,.6);

  animation: particlesFloatReverse 12s ease-in-out infinite alternate;
}

@keyframes particlesFloat {
  0% {
    transform: translate3d(0, 0, 0);
    opacity: .35;
  }

  50% {
    transform: translate3d(20px, -35px, 0);
    opacity: .8;
  }

  100% {
    transform: translate3d(-15px, 25px, 0);
    opacity: .45;
  }
}

@keyframes particlesFloatReverse {
  0% {
    transform: translate3d(0, 0, 0);
    opacity: .3;
  }

  100% {
    transform: translate3d(-30px, -40px, 0);
    opacity: .8;
  }
}


/* =========================================================
   MUSIC PLAYING — AMBIENT ENERGY
   ========================================================= */

.player:has(.sound-visualizer.playing)::before {
  content: "";
  position: absolute;
  inset: -2px;

  border-radius: inherit;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(139,92,246,.35),
      rgba(103,232,249,.3),
      rgba(236,72,153,.25),
      transparent
    );

  background-size: 300% 100%;
  animation: playerEnergy 3s linear infinite;

  opacity: .7;
  z-index: -1;
}

@keyframes playerEnergy {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 300% 50%;
  }
}


/* =========================================================
   PLAYING COVER — PULSING GLOW
   ========================================================= */

.player:has(.sound-visualizer.playing) .player-cover {
  animation: coverPulse 1.8s ease-in-out infinite;
}

@keyframes coverPulse {
  0%, 100% {
    box-shadow:
      0 0 0 rgba(139,92,246,0),
      0 0 15px rgba(139,92,246,.12);
  }

  50% {
    box-shadow:
      0 0 18px rgba(139,92,246,.4),
      0 0 45px rgba(103,232,249,.12);
  }
}


/* =========================================================
   VISUALIZER — MORE NATURAL WAVE
   ========================================================= */

.sound-visualizer.playing span {
  animation-name: musicBar !important;
  animation-duration: .55s !important;
  animation-timing-function: ease-in-out !important;
  animation-iteration-count: infinite !important;
  animation-direction: alternate !important;
}

@keyframes musicBar {
  0% {
    height: 4px !important;
    transform: scaleY(.55);
  }

  35% {
    height: 24px !important;
    transform: scaleY(1);
  }

  65% {
    height: 11px !important;
    transform: scaleY(.8);
  }

  100% {
    height: 28px !important;
    transform: scaleY(1);
  }
}


/* =========================================================
   IMAGE HOVER LIGHT
   ========================================================= */

.song-card {
  overflow: hidden;
}

.song-card::after {
  content: "";
  position: absolute;
  inset: -100%;

  background: linear-gradient(
    110deg,
    transparent 35%,
    rgba(255,255,255,.12) 50%,
    transparent 65%
  );

  transform: translateX(-60%) rotate(8deg);
  transition: transform .7s ease;
  pointer-events: none;
}

.song-card:hover::after {
  transform: translateX(60%) rotate(8deg);
}


/* =========================================================
   REDUCED MOTION SAFETY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }
}


/* =========================================================
   AURALIS — CINEMATIC NOW PLAYING ATMOSPHERE
   ========================================================= */

.player {
  position: relative;
  overflow: hidden;
}

/* Artwork-based cinematic layer */
.player::after {
  content: "";
  position: absolute;
  inset: 0;

  background-image: var(--player-art);
  background-size: cover;
  background-position: center;

  filter: blur(45px) saturate(1.5);
  transform: scale(1.25);

  opacity: 0;
  transition: opacity .8s ease;

  pointer-events: none;
  z-index: -2;
}

/* Reveal atmosphere while music plays */
.player:has(.sound-visualizer.playing)::after {
  opacity: .18;
  animation: playerArtworkMove 12s ease-in-out infinite alternate;
}

@keyframes playerArtworkMove {
  0% {
    transform: scale(1.25) translate3d(-1%, 0, 0);
    background-position: 0% 50%;
  }

  50% {
    transform: scale(1.35) translate3d(1%, -1%, 0);
    background-position: 100% 40%;
  }

  100% {
    transform: scale(1.25) translate3d(-1%, 1%, 0);
    background-position: 50% 100%;
  }
}

/* Animated cinematic color wash */
.player:has(.sound-visualizer.playing) {
  isolation: isolate;
}

.player:has(.sound-visualizer.playing)::before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 15% 50%,
      rgba(139,92,246,.22),
      transparent 35%
    ),
    radial-gradient(
      circle at 85% 50%,
      rgba(6,182,212,.18),
      transparent 35%
    );

  background-size: 200% 100%;
  animation: cinematicWash 6s ease-in-out infinite alternate;

  pointer-events: none;
  z-index: -1;
}

@keyframes cinematicWash {
  0% {
    background-position: 0% 50%;
  }

  100% {
    background-position: 100% 50%;
  }
}

/* =========================================================
   NOW PLAYING COVER
   ========================================================= */

.player:has(.sound-visualizer.playing) .player-cover img {
  animation: nowPlayingCover 8s ease-in-out infinite alternate;
}

@keyframes nowPlayingCover {
  0% {
    transform: scale(1);
    filter: saturate(1);
  }

  100% {
    transform: scale(1.06);
    filter: saturate(1.25) brightness(1.08);
  }
}

/* =========================================================
   PROGRESS BAR ENERGY
   ========================================================= */

.player:has(.sound-visualizer.playing) .progress-fill {
  background:
    linear-gradient(
      90deg,
      var(--auralis-accent),
      #06b6d4,
      #ec4899,
      var(--auralis-accent)
    ) !important;

  background-size: 300% 100% !important;
  animation: progressEnergy 3s linear infinite;
}

@keyframes progressEnergy {
  from {
    background-position: 0% 50%;
  }

  to {
    background-position: 300% 50%;
  }
}

/* =========================================================
   ACTIVE SONG TEXT
   ========================================================= */

.player:has(.sound-visualizer.playing) .player-song strong {
  background:
    linear-gradient(
      90deg,
      #fff,
      #c4b5fd,
      #67e8f9,
      #fff
    );

  background-size: 250% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;

  animation: titleGlow 4s linear infinite;
}

@keyframes titleGlow {
  to {
    background-position: 250% center;
  }
}


/* =========================================================
   AURALIS — PREMIUM SNOWFALL
   ========================================================= */

.snowfall {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 9999;
}

.snowflake {
  position: absolute;
  top: -30px;
  width: var(--size);
  height: var(--size);

  border-radius: 50%;
  background: rgba(255,255,255,.9);

  box-shadow:
    0 0 6px rgba(255,255,255,.8),
    0 0 14px rgba(180,220,255,.35);

  opacity: var(--opacity);
  filter: blur(var(--blur));

  animation:
    snowFall var(--duration) linear infinite,
    snowSway var(--sway) ease-in-out infinite alternate;
}

@keyframes snowFall {
  from {
    transform: translate3d(0, -40px, 0);
  }

  to {
    transform: translate3d(var(--drift), 110vh, 0);
  }
}

@keyframes snowSway {
  from {
    margin-left: -25px;
  }

  to {
    margin-left: 25px;
  }
}

/* Slightly dreamy glow */
.snowfall::after {
  content: "";
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(180,220,255,.035),
      transparent 45%
    );

  pointer-events: none;
}


/* ===== SNOWFALL BACKGROUND LAYER ===== */

.snowfall {
  position: fixed !important;
  inset: 0 !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
}

.snowflake {
  z-index: 0 !important;
}

/* Keep the actual website above the snowfall */
main > *:not(.snowfall) {
  position: relative;
  z-index: 1;
}




/* =========================================================
   AURALIS — CLEAN FINAL LAYOUT
   ========================================================= */

/* Main application frame */
main {
  display: grid !important;
  grid-template-columns: 250px minmax(0, 1fr) !important;
  grid-template-rows: minmax(0, 1fr) !important;

  width: 100% !important;
