@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  --bg: #07070a;
  --panel: rgba(18, 18, 25, 0.72);
  --panel-solid: #111117;
  --border: rgba(255, 255, 255, 0.08);
  --text: #f7f7fb;
  --muted: #8d8d9b;
  --accent: #9b6cff;
  --accent-2: #6c5ce7;
  --green: #b9ff66;
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 78% 8%, rgba(125, 72, 255, 0.15), transparent 28rem),
    radial-gradient(circle at 30% 30%, rgba(79, 45, 160, 0.08), transparent 32rem),
    var(--bg);
  color: var(--text);
  font-family: "Inter", sans-serif;
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

button {
  border: 0;
}

button,
.song-cover,
.song-info,
.music-card,
.mood-card {
  -webkit-tap-highlight-color: transparent;
}

/* =========================
   APP LAYOUT
========================= */

main {
  min-height: 100vh;
  padding-left: 255px;
  padding-bottom: 145px;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 255px;
  padding: 28px 18px;
  background: rgba(7, 7, 10, 0.78);
  border-right: 1px solid var(--border);
  backdrop-filter: blur(24px);
  z-index: 50;
  display: flex;
  flex-direction: column;
}

.logo {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 4px 10px 34px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.7px;
}

.logo-mark {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #b58cff, #6544e9);
  box-shadow: 0 8px 30px rgba(130, 80, 255, 0.35);
  font-weight: 800;
}

.menu-title,
.section-label {
  color: #666674;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.menu-title {
  padding: 0 12px 12px;
}

nav {
  display: grid;
  gap: 5px;
}

.nav-item {
  width: 100%;
  padding: 12px 13px;
  display: flex;
  align-items: center;
  gap: 13px;
  border-radius: 12px;
  background: transparent;
  color: #858592;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.nav-item span {
  font-size: 13px;
  font-weight: 600;
}

.nav-item:hover {
  color: white;
  background: rgba(255, 255, 255, 0.055);
  transform: translateX(2px);
}

.nav-item.active {
  color: white;
  background: linear-gradient(
    90deg,
    rgba(139, 92, 246, 0.2),
    rgba(139, 92, 246, 0.05)
  );
  box-shadow: inset 2px 0 0 #9b6cff;
}

.sidebar-bottom {
  margin-top: auto;
  padding: 14px;
  display: flex;
  gap: 11px;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.025);
}

.sidebar-bottom b,
.sidebar-bottom span {
  display: block;
}

.sidebar-bottom b {
  font-size: 12px;
}

.sidebar-bottom span {
  margin-top: 3px;
  color: var(--muted);
  font-size: 10px;
}

.mini-badge {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: rgba(155, 108, 255, 0.14);
  color: #b797ff;
}

/* =========================
   CONTENT
========================= */

.content {
  width: min(1250px, 100%);
  margin: auto;
  padding: 38px 42px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
}

.eyebrow {
  color: #8e71ff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2.2px;
}

.topbar h1 {
  margin: 8px 0 3px;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1;
  letter-spacing: -2.8px;
}

.subtitle {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.search {
  width: min(410px, 100%);
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 6px 5px 15px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.045);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(20px);
}

.search span {
  color: #8d7bff;
  font-size: 20px;
}

.search input,
.hero-search input {
  min-width: 0;
  flex: 1;
  border: 0;
  outline: 0;
  color: white;
  background: transparent;
}

.search input::placeholder,
.hero-search input::placeholder {
  color: #696975;
}

.search button,
.hero-search button {
  height: 38px;
  padding: 0 16px;
  border-radius: 11px;
  color: white;
  background: linear-gradient(135deg, #9b6cff, #6544e9);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 8px 25px rgba(116, 75, 230, 0.25);
  transition: 0.2s ease;
}

.search button:hover,
.hero-search button:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(116, 75, 230, 0.38);
}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  min-height: 365px;
  margin-top: 34px;
  padding: 48px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 28px;
  background:
    linear-gradient(110deg, rgba(45, 31, 81, 0.9), rgba(17, 16, 24, 0.9)),
    #111;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.3);
}

.hero::after {
  content: "";
  position: absolute;
  width: 440px;
  height: 440px;
  right: -120px;
  top: -150px;
  border-radius: 50%;
  background: rgba(151, 105, 255, 0.18);
  filter: blur(60px);
}

.hero-glow {
  position: absolute;
  width: 280px;
  height: 280px;
  right: 140px;
  bottom: -180px;
  border-radius: 50%;
  background: rgba(102, 82, 255, 0.2);
  filter: blur(50px);
}

.hero-text {
  position: relative;
  z-index: 2;
  max-width: 560px;
}

.hero-label {
  color: #c0a7ff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h2 {
  margin: 15px 0 13px;
  font-size: clamp(38px, 5vw, 64px);
  line-height: 0.98;
  letter-spacing: -3.5px;
}

.hero p {
  max-width: 420px;
  color: #aaa6b7;
  font-size: 14px;
  line-height: 1.7;
}

.hero-search {
  width: min(440px, 100%);
  height: 48px;
  margin-top: 25px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 5px 6px 5px 15px;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px;
  background: rgba(0,0,0,0.24);
}

.hero-search span {
  color: #a786ff;
  font-size: 19px;
}

.hero-art {
  position: absolute;
  right: 85px;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
}

.disc {
  width: 230px;
  height: 230px;
  border-radius: 50%;
  background:
    repeating-radial-gradient(
      circle,
      #1d1928 0 2px,
      #0c0b10 3px 5px
    );
  box-shadow:
    0 0 0 16px rgba(255,255,255,0.02),
    0 0 80px rgba(139, 92, 246, 0.35),
    0 30px 70px rgba(0,0,0,0.55);
  display: grid;
  place-items: center;
  animation: spin 18s linear infinite;
  animation-play-state: paused;
}

.disc-center {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #a875ff, #5e42d8);
  font-size: 27px;
  font-weight: 800;
  box-shadow: 0 0 30px rgba(150, 105, 255, 0.35);
}

/* =========================
   SECTIONS
========================= */

.section {
  margin-top: 48px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin: 6px 0 0;
  font-size: 22px;
  letter-spacing: -0.8px;
}

.section-heading > span {
  color: #72727f;
  font-size: 11px;
}

/* =========================
   SONG RESULTS
========================= */

.song-list {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: rgba(255,255,255,0.025);
}

.song-row {
  min-height: 70px;
  padding: 9px 16px;
  display: grid;
  grid-template-columns: 32px 50px minmax(180px, 1fr) 180px 65px 40px;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.045);
  transition: 0.2s ease;
}

.song-row:last-child {
  border-bottom: 0;
}

.song-row:hover,
.song-row.selected {
  background: rgba(139, 92, 246, 0.075);
}

.song-number {
  color: #5e5e6b;
  font-size: 11px;
  text-align: center;
}

.song-cover {
  position: relative;
  width: 50px;
  height: 50px;
  overflow: hidden;
  border-radius: 10px;
  cursor: pointer;
}

.song-cover img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: 0.25s ease;
}

.song-row:hover .song-cover img {
  transform: scale(1.07);
}

.cover-play {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.5);
  opacity: 0;
  font-size: 16px;
  transition: 0.2s ease;
}

.song-row:hover .cover-play,
.song-row.selected .cover-play {
  opacity: 1;
}

.song-info {
  min-width: 0;
  cursor: pointer;
}

.song-info strong,
.song-info span {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.song-info strong {
  font-size: 13px;
  font-weight: 600;
}

.song-info span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

.song-album,
.song-duration {
  color: #696976;
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.like {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: #686875;
  background: transparent;
  cursor: pointer;
  font-size: 18px;
  transition: 0.2s ease;
}

.like:hover {
  color: #fff;
  background: rgba(255,255,255,0.06);
}

.like.liked {
  color: #ff6eaf;
}

/* =========================
   MUSIC CARDS
========================= */

.music-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.music-card {
  min-width: 0;
  padding: 11px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(255,255,255,0.025);
  transition: 0.25s ease;
}

.music-card:hover {
  transform: translateY(-5px);
  background: rgba(255,255,255,0.05);
  border-color: rgba(155,108,255,0.25);
}

.card-image {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 13px;
}

.card-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: 0.3s ease;
}

.music-card:hover .card-image img {
  transform: scale(1.05);
}

.card-play {
  position: absolute;
  right: 10px;
  bottom: 10px;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  color: white;
  background: #9b6cff;
  box-shadow: 0 10px 30px rgba(0,0,0,0.35);
  cursor: pointer;
  opacity: 0;
  transform: translateY(8px);
  transition: 0.2s ease;
}

.music-card:hover .card-play {
  opacity: 1;
  transform: translateY(0);
}

.music-card > strong,
.music-card > span {
  display: block;
}

.music-card > strong {
  margin: 13px 3px 0;
  font-size: 13px;
}

.music-card > span {
  margin: 5px 3px 3px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================
   MOODS
========================= */

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.mood-card {
  min-height: 115px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
  background: rgba(255,255,255,0.025);
  transition: 0.25s ease;
}

.mood-card:hover {
  transform: translateY(-4px);
}

.mood-card > span {
  font-size: 24px;
}

.mood-card b,
.mood-card small {
  display: block;
}

.mood-card b {
  font-size: 13px;
}

.mood-card small {
  margin-top: 4px;
  color: rgba(255,255,255,0.55);
  font-size: 10px;
}

.night {
  background: linear-gradient(135deg, rgba(75,52,130,0.42), rgba(16,16,22,0.8));
}

.energy {
  background: linear-gradient(135deg, rgba(173,68,89,0.34), rgba(16,16,22,0.8));
}

.chill {
  background: linear-gradient(135deg, rgba(47,107,124,0.34), rgba(16,16,22,0.8));
}

.trending {
  background: linear-gradient(135deg, rgba(96,75,30,0.38), rgba(16,16,22,0.8));
}

/* =========================
   PLAYER
========================= */

.player {
  position: fixed;
  left: 275px;
  right: 20px;
  bottom: 18px;
  z-index: 100;
  min-height: 82px;
  padding: 11px 18px;
  display: grid;
  grid-template-columns: minmax(220px, 1fr) minmax(360px, 1.5fr) minmax(150px, 0.6fr);
  align-items: center;
  gap: 25px;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px;
  background: rgba(15,15,21,0.82);
  box-shadow: 0 25px 80px rgba(0,0,0,0.55);
  backdrop-filter: blur(28px);
}

.player-song {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12px;
}

.player-cover {
  width: 54px;
  height: 54px;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 10px;
  background: #19191f;
}

.player-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.player-song strong,
.player-song span {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.player-song strong {
  font-size: 12px;
}

.player-song span {
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

.player-center {
  min-width: 0;
}

.player-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17px;
}

.player-buttons button {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: #aaaab5;
  background: transparent;
  cursor: pointer;
  transition: 0.2s ease;
}

.player-buttons button:hover {
  color: white;
  background: rgba(255,255,255,0.06);
}

.player-buttons .play-button {
  width: 42px;
  height: 42px;
  color: #08080b;
  background: white;
  font-size: 14px;
}

.player-buttons .play-button:hover {
  transform: scale(1.06);
  background: #fff;
}

.progress {
  margin-top: 7px;
  display: grid;
  grid-template-columns: 34px 1fr 34px;
  align-items: center;
  gap: 8px;
}

.progress span {
  color: #73737f;
  font-size: 9px;
  text-align: center;
}

.progress input,
.player-volume input {
  width: 100%;
  height: 4px;
  accent-color: #9b6cff;
  cursor: pointer;
}

.player-volume {
  display: flex;
  align-items: center;
  gap: 10px;
}

.player-volume span {
  font-size: 13px;
}

.player-volume input {
  max-width: 130px;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1000px) {
  main {
    padding-left: 82px;
  }

  .sidebar {
    width: 82px;
    padding: 22px 12px;
  }

  .logo {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .logo span,
  .menu-title,
  .nav-item span,
  .sidebar-bottom > div:not(.mini-badge) {
    display: none;
  }

  .nav-item {
    justify-content: center;
  }

  .sidebar-bottom {
    justify-content: center;
  }

  .player {
    left: 96px;
  }

  .hero-art {
    right: 35px;
    opacity: 0.65;
  }

  .song-row {
    grid-template-columns: 25px 48px minmax(150px, 1fr) 55px 35px;
  }

  .song-album {
    display: none;
  }

  .music-grid,
  .mood-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  main {
    padding-left: 0;
    padding-bottom: 190px;
  }

  .sidebar {
    position: fixed;
    inset: auto 0 0 0;
    width: auto;
    height: 68px;
    padding: 7px 12px;
    flex-direction: row;
    justify-content: center;
    border-top: 1px solid var(--border);
    border-right: 0;
  }

  .logo,
  .menu-title,
  .sidebar-bottom {
    display: none;
  }

  nav {
    width: 100%;
    max-width: 420px;
    display: flex;
    justify-content: space-around;
  }

  .nav-item {
    width: 58px;
    padding: 9px;
    justify-content: center;
  }

  .content {
    padding: 24px 16px;
  }

  .topbar {
    display: block;
  }

  .topbar h1 {
    font-size: 38px;
  }

  .search {
    width: 100%;
    margin-top: 22px;
  }

  .hero {
    min-height: 410px;
    padding: 30px 25px;
  }

  .hero h2 {
    font-size: 43px;
  }

  .hero-art {
    right: 50%;
    top: auto;
    bottom: -80px;
    transform: translateX(50%);
    opacity: 0.55;
  }

  .song-row {
    grid-template-columns: 22px 46px minmax(0, 1fr) 32px;
    padding: 8px;
  }

  .song-duration {
    display: none;
  }

  .music-grid,
  .mood-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .player {
    left: 10px;
    right: 10px;
    bottom: 78px;
    grid-template-columns: 1fr;
    gap: 7px;
    padding: 10px 13px;
  }

  .player-volume {
    display: none;
  }

  .player-buttons {
    margin-top: -55px;
    margin-left: auto;
    width: 140px;
    position: relative;
  }

  .progress {
    margin-top: 6px;
  }
}

@media (prefers-reduced-motion: no-preference) {
  .song-row,
  .music-card,
  .mood-card,
  .nav-item,
  button {
    transition:
      transform 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      opacity 180ms ease;
  }
}

/* ─────────────────────────────
   AURALIS LIQUID GLASS PLAYER
   ───────────────────────────── */

.player {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.12),
      rgba(255,255,255,0.035)
    );
  backdrop-filter: blur(28px) saturate(180%);
  -webkit-backdrop-filter: blur(28px) saturate(180%);

  border: 1px solid rgba(255,255,255,0.14);
  box-shadow:
    0 20px 60px rgba(0,0,0,0.45),
    inset 0 1px 0 rgba(255,255,255,0.12);

  border-radius: 24px;
}

/* Glass play controls */

.player-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
}

.player-buttons button {
  width: 42px;
  height: 42px;

  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50%;

  color: rgba(255,255,255,0.78);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.10),
      rgba(255,255,255,0.025)
    );

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.10),
    0 8px 25px rgba(0,0,0,0.25);

  cursor: pointer;

  transition:
    transform .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}

.player-buttons button:hover {
  transform: translateY(-2px) scale(1.06);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.18),
      rgba(255,255,255,0.05)
    );

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.16),
    0 10px 30px rgba(0,0,0,0.35);
}

/* Main play button */

.player-buttons .play-button {
  width: 56px;
  height: 56px;

