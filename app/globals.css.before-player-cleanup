    inset 0 -1px 2px rgba(0,0,0,0.15),
    0 8px 30px rgba(0,0,0,0.25);

  transition:
    transform 0.3s cubic-bezier(.2,.8,.2,1),
    box-shadow 0.3s ease;
}

/* Moving liquid layer */
.player-buttons button::before,
.player-volume::before {
  content: "";
  position: absolute;
  width: 180%;
  height: 180%;
  left: -40%;
  top: -40%;

  background:
    radial-gradient(
      circle at 30% 30%,
      rgba(255,255,255,0.45),
      transparent 28%
    ),
    radial-gradient(
      circle at 70% 65%,
      rgba(180,220,255,0.28),
      transparent 35%
    );

  filter: blur(12px);
  opacity: 0.8;

  animation: liquidFloat 5s ease-in-out infinite;

  z-index: -1;
}

/* Second water reflection */
.player-buttons button::after,
.player-volume::after {
  content: "";
  position: absolute;
  width: 140%;
  height: 35%;

  left: -20%;
  top: 10%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,0.38),
    transparent
  );

  filter: blur(8px);
  transform: rotate(-8deg);

  animation: waterShine 4s ease-in-out infinite;

  pointer-events: none;
}

/* Floating effect */

.player-buttons button:hover {
  transform: translateY(-8px) scale(1.06) !important;

  box-shadow:
    inset 0 1px 2px rgba(255,255,255,0.5),
