.player-volume:hover {
  transform: translateY(-8px);

  box-shadow:
    inset 0 1px 2px rgba(255,255,255,0.5),
    0 15px 45px rgba(255,255,255,0.12);
}

/* Liquid movement */

@keyframes liquidFloat {
  0% {
    transform: translate3d(-8%, -5%, 0) rotate(0deg) scale(1);
  }

  25% {
    transform: translate3d(8%, 4%, 0) rotate(8deg) scale(1.08);
  }

  50% {
    transform: translate3d(2%, -8%, 0) rotate(-5deg) scale(1.15);
  }

  75% {
    transform: translate3d(-9%, 5%, 0) rotate(6deg) scale(1.08);
  }

  100% {
    transform: translate3d(-8%, -5%, 0) rotate(0deg) scale(1);
  }
}

@keyframes waterShine {
  0% {
    transform: translateX(-120%) rotate(-8deg);
    opacity: 0;
  }

  35% {
    opacity: 0.8;
  }

  70% {
    opacity: 0;
  }

  100% {
    transform: translateX(120%) rotate(-8deg);
    opacity: 0;
  }
}


