/* ===== PREMIUM QUEUE ADD BUTTON ===== */

.queue-add {
  position: relative;
  width: 36px;
  height: 36px;
  flex: 0 0 36px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.12),
      rgba(255,255,255,.035)
    );

  color: rgba(255,255,255,.78);
  font-size: 22px;
  font-weight: 400;
  line-height: 1;

  cursor: pointer;
  overflow: hidden;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.12),
    0 5px 18px rgba(0,0,0,.18);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  transition:
    transform .18s cubic-bezier(.2,.8,.2,1),
    background .2s ease,
    border-color .2s ease,
    color .2s ease,
    box-shadow .2s ease;
}

.queue-add::after {
  content: "";
  position: absolute;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
  transform: scale(0);
  opacity: 0;
  pointer-events: none;
}

.queue-add:hover {
  transform: translateY(-2px) scale(1.06);
  color: #fff;
  border-color: rgba(255,255,255,.28);
  background: rgba(255,255,255,.14);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.16),
    0 8px 24px rgba(0,0,0,.3);
}

.queue-add:active {
  transform: scale(.88);
}

.queue-add:active::after {
  animation: queueRipple .42s ease-out;
}

.queue-add.queue-added {
  color: #fff;
  border-color: rgba(255,255,255,.3);
  background: rgba(255,255,255,.18);
  animation: queueAdded .35s cubic-bezier(.2,.9,.3,1);
}

@keyframes queueRipple {
  0% {
    transform: scale(0);
    opacity: .45;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

@keyframes queueAdded {
  0% {
    transform: scale(.8) rotate(-10deg);
  }
  55% {
    transform: scale(1.16) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}


