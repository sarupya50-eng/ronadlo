import { NextRequest, NextResponse } from "next/server";

type LyricsResult = {
  id: number;
  trackName: string;
  artistName: string;
  albumName: string | null;
  duration: number;
  instrumental: boolean;
  plainLyrics: string | null;
  syncedLyrics: string | null;
};

function cleanTitle(title: string) {
  return title
    .replace(/\(official.*?\)/gi, "")
    .replace(/\[official.*?\]/gi, "")
    .replace(/\(lyrics?\)/gi, "")
    .replace(/\[lyrics?\]/gi, "")
    .replace(/\(audio\)/gi, "")
    .replace(/\[audio\]/gi, "")
    .replace(/\(slowed.*?\)/gi, "")
    .replace(/\[slowed.*?\]/gi, "")
    .replace(/\(reverb.*?\)/gi, "")
    .replace(/\[reverb.*?\]/gi, "")
    .replace(/\s+/g, " ")
    .trim();
}

async function searchLRCLIB(query: string) {
  const url =
    `https://lrclib.net/api/search?q=${encodeURIComponent(query)}`;

  const response = await fetch(url, {
    headers: {
      "User-Agent":
        "Auralis Music/1.0 (https://github.com/auralis-music)",
    },
    cache: "no-store",
  });

  if (!response.ok) return [];

  return (await response.json()) as LyricsResult[];
}

export async function GET(request: NextRequest) {
  const params = request.nextUrl.searchParams;

  const track = params.get("track")?.trim();
  const artist = params.get("artist")?.trim();

  if (!track) {
    return NextResponse.json(
      { error: "Missing track" },
      { status: 400 }
    );
  }

  try {
    const clean = cleanTitle(track);

    const queries = [
      `${clean} ${artist || ""}`.trim(),
      clean,
      track,
    ];

    let matches: LyricsResult[] = [];

    for (const query of queries) {
      matches = await searchLRCLIB(query);

      if (matches.length > 0) {
        break;
      }
    }

    if (!matches.length) {
      return NextResponse.json({
        lyrics: [],
        syncedLyrics: null,
        found: false,
      });
    }

    // Prefer results containing lyrics.
    const withLyrics = matches.filter(
      (item) =>
        item.plainLyrics ||
        item.syncedLyrics
    );

    const best = withLyrics[0];

    if (!best) {
      return NextResponse.json({
        lyrics: [],
        syncedLyrics: null,
        found: false,
      });
    }

    return NextResponse.json({
      found: true,
      title: best.trackName,
      artist: best.artistName,
      album: best.albumName,
      duration: best.duration,

      lyrics: best.plainLyrics
        ? best.plainLyrics
            .split(/\r?\n/)
            .map((line) => line.trim())
            .filter(Boolean)
        : [],

      syncedLyrics: best.syncedLyrics || null,
    });
  } catch (error) {
    console.error("Lyrics API error:", error);

    return NextResponse.json(
      {
        lyrics: [],
        syncedLyrics: null,
        found: false,
        error: "Failed to fetch lyrics",
      },
      { status: 500 }
    );
  }
}
